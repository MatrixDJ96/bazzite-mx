# msi-ec: the out-of-tree driver for the embedded controller of MSI laptops
# (fan curves, shift modes, keyboard backlight, battery thresholds). The ogc
# kernel ships CONFIG_MSI_EC=m, but the in-tree copy prints no version and
# lags the project, so this one goes to updates/, which depmod searches first.
URL=https://github.com/BeardOverflow/msi-ec.git
# Pinned on purpose: the module is rebuilt on every base kernel and must not
# change under a rebuild. A bump is a reviewed diff of this line.
COMMIT=d7fbbd88e6831e56801b860e46475cbf8ddbc7c1
KO_NAME=msi-ec
# `make -C <kernel> M=<clone> modules` leaves the object at the clone root
# (Makefile: obj-m += msi-ec.o).
KO_BUILD_PATH=msi-ec.ko
# MODULE_VERSION at that commit; the builder asserts it.
KO_VERSION=0.13
