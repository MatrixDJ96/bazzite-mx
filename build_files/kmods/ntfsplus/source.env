# ntfsplus: the author's standalone packaging of NTFSPLUS, the read/write NTFS
# driver Linux carries as fs/ntfs. The closed-driver flavour's 6.18 kernel
# has no fs/ntfs; the 7.2 kernel of the other two builds it in-tree, and this
# build shadows it from updates/. It loads at a mount of type ntfs (55-ntfsplus.sh).
#
# Sourced by build_files/kmods/build-kmods.sh in the kmod-builder stage, by
# 50-kmods.sh at install and by tests/50-kmods.sh: URL, COMMIT, KO_NAME and
# KO_BUILD_PATH required.

URL=https://github.com/namjaejeon/linux-ntfs.git

# Pinned on purpose, and to a merge commit of main only: ntfs-next is
# force-pushed and its tip may be mid-rework. A bump needs the runtime mount
# proof on a booted target kernel, because vermagic and modinfo pass on a module
# whose breakage is a runtime mismatch.
COMMIT=fdfea0c9a7b4e294daffa839e76bb41d69ec192c

# The Makefile emits ntfs.ko and the driver registers the filesystem type
# "ntfs": "ntfsplus" is the project's name, never the module's or the mount
# type's.
KO_NAME=ntfs

# `make -C <kernel> M=<clone> modules` leaves the object at the clone root
# (Makefile: obj-$(CONFIG_NTFS_FS) += ntfs.o).
KO_BUILD_PATH=ntfs.ko

# Forced: a kbuild fragment gated on a kernel config symbol compiles nothing on
# a kernel that leaves the symbol unset, and the build still exits 0.
KO_BUILD_ARGS=CONFIG_NTFS_FS=m

# No MODULE_VERSION in the source: nothing to assert.
KO_VERSION=
