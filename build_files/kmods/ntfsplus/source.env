# ntfsplus: NTFSPLUS, the read/write NTFS driver Linux carries as fs/ntfs, from
# our fork of its author's standalone packaging. The closed-driver flavour's
# 6.18 kernel has no fs/ntfs; the 7.2 kernel of the other two builds it
# in-tree, and this build shadows it from updates/. It loads at a mount of type
# ntfs (55-ntfsplus.sh).
#
# Sourced by build_files/kmods/build-kmods.sh in the kmod-builder stage, by
# 50-kmods.sh at install and by tests/50-kmods.sh: URL, COMMIT or TAG, KO_NAME
# and KO_BUILD_PATH required.

URL=https://github.com/MatrixDJ96/linux-ntfs.git

# The fork's CI moves the tag to the tested tip of its bazzite-mx branch when,
# on the image's kernels and the newest ogc one, the branch fails no test
# ntfs-next passes. The branch is ntfs-next with the fork's CI commit on top,
# then the Linux master ntfs: commits ntfs-next lacks (divergences.md names
# those left out), then the fixes upstream has not merged yet.
TAG=stable

# The Makefile emits ntfs.ko and the driver registers the filesystem type
# "ntfs": "ntfsplus" is the project's name, never the module's or the mount
# type's.
KO_NAME=ntfs

# `make -C <kernel> M=<clone> modules` leaves the object at the clone root
# (Makefile: obj-$(CONFIG_NTFS_FS) += ntfs.o).
KO_BUILD_PATH=ntfs.ko

# Forced: a kbuild fragment gated on a kernel config symbol compiles nothing on
# a kernel that leaves the symbol unset, and the build still exits 0. WOF reads
# the files Windows keeps under system compression; no base kernel enables it.
KO_BUILD_ARGS="CONFIG_NTFS_FS=m CONFIG_NTFS_FS_WOF_COMPRESSION=y"

# No MODULE_VERSION in the source: nothing to assert.
KO_VERSION=
