# acpi_ec: ec_sys reworked as a character device. It creates the root-only
# /dev/ec that MControlCenter falls back to for fan speeds and fan curves,
# because the ogc kernel leaves CONFIG_ACPI_EC_DEBUGFS unset and so ships no
# ec_sys module to load.
URL=https://github.com/saidsay-so/acpi_ec.git
# Pinned on purpose: master, two commits past 1.0.4 that touch only README,
# debian/control and install.sh. A bump is a reviewed diff of this line.
COMMIT=e83e5a6122e15a83cc52883ac24bf9b1880fd53c
KO_NAME=acpi_ec
# The Makefile has obj-m += src/acpi_ec.o, so the object lands under src/.
KO_BUILD_PATH=src/acpi_ec.ko
# The source carries no MODULE_VERSION: nothing to assert.
KO_VERSION=
