# Sunshine from the COPR lizardbyte/stable (https://docs.lizardbyte.dev/projects/sunshine),
# the section `dnf5 copr enable` writes, with enabled=0 (41-sunshine.sh enables it for one
# transaction), the project key read from the copy under /etc/pki/rpm-gpg and without the
# COPR file's priority=1, which would let this repository override Fedora's packages.
[copr:copr.fedorainfracloud.org:lizardbyte:stable]
name=Copr repo for stable owned by lizardbyte
baseurl=https://download.copr.fedorainfracloud.org/results/lizardbyte/stable/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=True
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-copr-lizardbyte-stable
repo_gpgcheck=0
enabled=0
enabled_metadata=1
