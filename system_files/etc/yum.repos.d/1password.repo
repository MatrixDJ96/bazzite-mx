# 1Password, stable channel: the stanza https://support.1password.com/install-linux/
# gives for Fedora, with enabled=0 (40-desktop-apps.sh enables it for one transaction) and the
# key read from the copy under /etc/pki/rpm-gpg. The package's %post rewrites this file; the
# build restores this copy and 90-validate-repos.sh checks it.
[1password]
name=1Password Stable Channel
baseurl=https://downloads.1password.com/linux/rpm/stable/$basearch
enabled=0
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-1password
