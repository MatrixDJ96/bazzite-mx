# Docker CE, stable channel: the [docker-ce-stable] stanza of
# https://download.docker.com/linux/fedora/docker-ce.repo, with enabled=0
# (21-container-runtime.sh enables it for one transaction) and the key read from the copy
# under /etc/pki/rpm-gpg.
[docker-ce-stable]
name=Docker CE Stable - $basearch
baseurl=https://download.docker.com/linux/fedora/$releasever/$basearch/stable
enabled=0
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-docker-ce
