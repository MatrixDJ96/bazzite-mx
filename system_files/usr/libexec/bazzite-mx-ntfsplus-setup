#!/usr/bin/env bash
# Switch one host between the ntfs3 driver and the NTFSPLUS driver the image
# ships as the filesystem type "ntfs", blacklisted until the host opts in.
# The root half of `ujust setup-ntfsplus`.
#
# Usage: bazzite-mx-ntfsplus-setup [status | enable | disable | --self-test]
#   status       module, opt-in, driver, fstab rows by type, mounted volumes
#                (the default; no root needed)
#   enable       write the opt-in, prove the driver on a loop image, rewrite
#                the ntfs3 rows of fstab to ntfs, give every ntfs row without
#                an errors= option errors=remount-ro, remount them (root)
#   disable      rewrite the ntfs rows back to ntfs3 and remount them, remove
#                the opt-in and the backup, unload the driver (root)
#   --self-test  the fstab rewrites, the field unescaping, the remount, the
#                status output and the alias probe on fixtures; stops at the
#                first failed check
#
# Exit status: 0 done; 1 refused or failed, the reason on stderr as `ERROR: …`
# (a failed self-test prints `self-test: …` on stdout instead).
# Writes: the opt-in /etc/modprobe.d/bazzite-mx-ntfsplus.conf, /etc/fstab and
# its backup /etc/fstab.bazzite-mx-ntfsplus.bak (taken before the first
# rewrite), a probe image and mount point under /var/tmp removed before exit.
# The last line of a green self-test starts with `self-test ok`, which
# tests/55-ntfsplus.sh reads. FIXTURE=<dir> (host.sh) redirects the files
# `status` reads under <dir>.
set -euo pipefail

# shellcheck source=../lib/bazzite-mx/host.sh
source /usr/lib/bazzite-mx/host.sh

MODULE=ntfs
BACKUP=/etc/fstab.bazzite-mx-ntfsplus.bak
PROBE_MB=64

# --- fstab --------------------------------------------------------------------

fstab_rows_of_type() {
    local fstab=$1 type=$2

    fstab_entries "$fstab" | awk -v type="$type" '$3 == type'
}

mount_points_of_type() {
    local fstab=$1 type=$2

    fstab_rows_of_type "$fstab" "$type" | awk '{ print $2 }'
}

# mount_points_to_rewrite <fstab> <from> <to>: the points of the rows
# replace_fstab_type (host.sh) changes.
mount_points_to_rewrite() {
    local fstab=$1 from=$2 to=$3

    fstab_entries "$fstab" | awk -v from="$from" -v to="$to" \
        '$3 == from || (to == "ntfs" && $3 == to && $4 !~ /(^|,)errors=/) { print $2 }'
}

count_rows_of_type() {
    local fstab=$1 type=$2

    fstab_rows_of_type "$fstab" "$type" | grep -c ''
}

# --- the host -----------------------------------------------------------------

# Empty when the image carries no ntfs module for the running kernel.
module_path() {
    modinfo -n "$MODULE" 2> /dev/null || true
}

# src_ntfs_mounts: what findmnt lists as mounted with an NTFS driver, one
# "<target> <fstype> <source>" line each; from a fixture, the cmd/mounts
# lines ("<target> <fstype>") of those types. findmnt exits 0 with nothing
# printed when no row matches, which is the empty answer, and 1 on any error
# (docs/gotchas.md § `findmnt -t` exits 1 on any error and 0 with nothing on
# no match), so a non-zero status is a failure, never an unmounted host:
# status 1 with the `ERROR:` line then, for the caller to end the run.
src_ntfs_mounts() {
    local mounts

    if [ -n "$FIXTURE" ]; then
        awk '$NF == "ntfs" || $NF == "ntfs3" || $NF == "fuseblk"' "$FIXTURE/cmd/mounts"
        return 0
    fi

    if ! mounts=$(findmnt -t ntfs,ntfs3,fuseblk -o TARGET,FSTYPE,SOURCE -n 2>&1); then
        print_error "cannot read the mounted NTFS volumes:" \
            "$(reason_on_one_line "$mounts")"
        return 1
    fi

    if [ -n "$mounts" ]; then
        echo "$mounts"
    fi
}

# Status 0 when the kernel's own route, request_module("fs-ntfs"), would load
# the driver, loaded now or not. The config is captured before the grep and
# the dry run is --show-depends: docs/gotchas.md § `modprobe -n -v` is silent
# for a loaded module; `--show-depends` is not.
ntfs_alias_resolves() {
    local config dry_run

    if ! config=$(modprobe -c); then
        return 1
    fi

    if grep -qx "blacklist $MODULE" <<< "$config"; then
        return 1
    fi

    if ! dry_run=$(modprobe -n --show-depends "fs-$MODULE" 2> /dev/null); then
        return 1
    fi

    grep -q '^insmod ' <<< "$dry_run"
}

# --- status -------------------------------------------------------------------

show_status() {
    local fstab type mount_points mounted

    if [ -n "$FIXTURE" ]; then
        echo "module: fixture"
    elif [ -n "$(module_path)" ]; then
        echo "module: $(module_path) (kernel $(uname -r))"
    else
        echo "module: none for kernel $(uname -r): this image carries no ntfsplus"
    fi

    if ntfsplus_optin; then
        echo "opt-in: active ($NTFSPLUS_OPTIN masks the image's blacklist)"
    else
        echo "opt-in: not active (the kernel never loads the driver on its own)"
    fi

    if ntfs_registered; then
        echo "driver ntfs: registered (/proc/filesystems)"
    else
        echo "driver ntfs: not registered"
    fi

    fstab=$(host_file /etc/fstab)

    for type in ntfs ntfs3 ntfs-3g; do
        mount_points=$(mount_points_of_type "$fstab" "$type" | unescaped_on_one_line || true)
        echo "fstab $type: ${mount_points:-none}"
    done

    if ! mounted=$(src_ntfs_mounts); then
        exit 1
    fi

    if [ -n "$mounted" ]; then
        echo "mounted:"
        sed 's/^/  /' <<< "$mounted"
    else
        echo "mounted: none"
    fi
}

# --- the runtime probe --------------------------------------------------------
#
# A module built against the wrong kernel API passes vermagic and modinfo and
# dies at its first mount; at boot that mount fires before the journal is on
# disk (docs/gotchas.md § A kernel module can pass vermagic and modinfo and
# panic at its first use). So a loop image is formatted, mounted by the kernel
# driver, written, remounted and checksummed before a single fstab row
# changes. Every step returns a status after printing its reason, and a trap
# removes the files.

remove_probe_files() {
    local mount_point=$1 image=$2

    umount "$mount_point" 2> /dev/null || true
    rmdir "$mount_point" 2> /dev/null || true
    rm -f "$image"
}

format_and_mount_probe() {
    local image=$1 mount_point=$2 mounted_as error

    truncate -s "${PROBE_MB}M" "$image"

    if ! mkntfs -F -Q "$image" > /dev/null 2>&1; then
        print_error "mkntfs failed on the $PROBE_MB MB probe image"
        return 1
    fi

    if ! error=$(mount -t ntfs -o loop "$image" "$mount_point" 2>&1); then
        print_error "mount -t ntfs of the probe image failed" \
            "($(reason_on_one_line "$error"); journalctl -k -b | tail)"
        return 1
    fi

    mounted_as=$(findmnt -n -o FSTYPE --mountpoint "$mount_point" 2> /dev/null || true)

    if [ "$mounted_as" != ntfs ]; then
        print_error "the probe mounted as ${mounted_as:-no answer from findmnt}," \
            "not with the kernel driver"
        return 1
    fi
}

write_probe_content() {
    local mount_point=$1 i

    if ! dd if=/dev/urandom of="$mount_point/blob" bs=1M count=8 status=none; then
        print_error "write to the probe image failed"
        return 1
    fi

    for i in $(seq 1 20); do
        if ! mkdir "$mount_point/d$i" || ! : > "$mount_point/d$i/f"; then
            print_error "directory entry $i on the probe image failed"
            return 1
        fi
    done
}

probe_survives_remount() {
    local image=$1 mount_point=$2 checksum_before=$3 checksum_after directories error

    if ! error=$(umount "$mount_point" 2>&1); then
        print_error "umount of the probe image failed ($(reason_on_one_line "$error"))"
        return 1
    fi

    if ! error=$(mount -t ntfs -o loop "$image" "$mount_point" 2>&1); then
        print_error "second mount of the probe image failed ($(reason_on_one_line "$error"))"
        return 1
    fi

    if ! checksum_after=$(sha256sum "$mount_point/blob" | cut -d' ' -f1); then
        print_error "the probe file cannot be read after the remount"
        return 1
    fi

    if [ "$checksum_after" != "$checksum_before" ]; then
        print_error "the probe file changed across a remount"
        return 1
    fi

    if ! directories=$(find "$mount_point" -mindepth 1 -maxdepth 1 -type d 2> /dev/null \
        | wc -l); then
        print_error "the probe directories cannot be listed after the remount"
        return 1
    fi

    if [ "$directories" -ne 20 ]; then
        print_error "directory entries lost across a remount"
        return 1
    fi

    if ! error=$(umount "$mount_point" 2>&1); then
        print_error "final umount of the probe image failed ($(reason_on_one_line "$error"))"
        return 1
    fi
}

run_runtime_probe() {
    local image mount_point checksum

    image=$(mktemp /var/tmp/bazzite-mx-ntfsplus-probe.XXXXXX)
    mount_point=$(mktemp -d /var/tmp/bazzite-mx-ntfsplus-mnt.XXXXXX)

    # Every exit of this function removes the two, the interrupted one
    # included: a Ctrl-C between the mount and the umount would otherwise
    # leave the probe mounted, and `disable` then reports the driver in use
    # for ever without naming the holder. A RETURN trap does not run when a
    # signal ends the script, so the interrupt has its own. Both are disarmed
    # by the RETURN body: a RETURN trap set in a function outlives it and
    # would fire again at the caller's return, where the two locals are gone.
    trap 'remove_probe_files "$mount_point" "$image"; trap - INT RETURN' RETURN
    trap 'remove_probe_files "$mount_point" "$image"; exit 130' INT

    if ! format_and_mount_probe "$image" "$mount_point" \
        || ! write_probe_content "$mount_point"; then
        return 1
    fi

    if ! checksum=$(sha256sum "$mount_point/blob" | cut -d' ' -f1); then
        print_error "the probe file cannot be read"
        return 1
    fi

    if ! probe_survives_remount "$image" "$mount_point" "$checksum"; then
        return 1
    fi

    echo "runtime probe: $PROBE_MB MB loop image formatted, mounted as ntfs," \
        "8 MB + 20 entries written, checksum stable across a remount"
}

# --- switching the fstab rows -------------------------------------------------

# install_fstab <file> <from>: refuses a rewritten table that adds a findmnt
# --verify error to the current one, installs it otherwise, reloads systemd
# and prints the verdict, pre-existing errors counted, not fatal: an
# unplugged nofail volume is one before any rewrite (docs/gotchas.md §
# `findmnt --verify` reports an unplugged `nofail` volume as an error). The
# comparison (host.sh) is trusted only once findmnt has answered on both
# tables. Status 1 with the reason printed when the table was refused or
# could not be written: <file> removed, a backup already taken kept, and
# /etc/fstab untouched: the table is written beside and renamed; the caller
# decides what that unwinds, so this returns instead of exiting, and the
# caller's `if !` suspends `set -e` in here, so every write checks its own
# status. The one exit: a `systemctl daemon-reload` that fails AFTER the
# table is written, where nothing is unwound and the run ends with the
# manual step to take.
install_fstab() {
    local file=$1 from=$2 added kept

    if [ "$(count_rows_of_type "$file" "$from")" -ne 0 ]; then
        echo "fstab: the rewrite left $from rows"
        rm -f "$file"
        return 1
    fi

    # The rewritten table has the current one's rows with the type column
    # switched and errors=remount-ro added or dropped, so the current table's
    # diagnostic names the row to fix.
    if ! fstab_verify_answers /etc/fstab || ! fstab_verify_answers "$file"; then
        fstab_verify_output /etc/fstab
        echo "fstab: findmnt --verify gave no verdict, the rewrite cannot be judged"
        rm -f "$file"
        return 1
    fi

    added=$(new_verify_errors /etc/fstab "$file")

    if [ -n "$added" ]; then
        echo "$added"
        echo "fstab: the rewritten table adds findmnt --verify error(s)"
        rm -f "$file"
        return 1
    fi

    # A cp that fails on a full disk leaves an empty file, which the next run
    # would keep as the backup it names to the user.
    if [ ! -e "$BACKUP" ]; then
        if ! cp -p /etc/fstab "$BACKUP" 2> /dev/null; then
            echo "fstab: could not back up /etc/fstab to $BACKUP"
            rm -f "$BACKUP" "$file"
            return 1
        fi
    fi

    if ! install -m 0644 -o root -g root "$file" /etc/fstab.new 2> /dev/null \
        || ! mv -f /etc/fstab.new /etc/fstab 2> /dev/null; then
        echo "fstab: could not write /etc/fstab (the table before the first rewrite: $BACKUP)"
        rm -f "$file" /etc/fstab.new
        return 1
    fi

    if ! systemctl daemon-reload; then
        rm -f "$file"
        exit_with_error "systemctl daemon-reload failed after writing /etc/fstab" \
            "(backup $BACKUP): run it by hand"
    fi

    kept=$(fstab_verify_errors /etc/fstab | grep -c '' || true)
    echo "findmnt --verify: no error added by the rewrite, $kept pre-existing error(s) kept"
}

# A busy volume keeps its mount until the next boot; nothing is forced. A
# volume the new driver refuses is fatal, because its row is already <to> and
# a reboot would fail the same way.
remount_switched_rows() {
    local mount_points=$1 to=$2 mount_point mounted revert cause kernel_log error

    # NTFSPLUS mounts a dirty volume, read-only under the rewrite's errors=remount-ro.
    if [ "$to" = ntfs ]; then
        revert=disable
        cause="the reason names the option NTFSPLUS refused"
        kernel_log=
    else
        revert=enable
        cause="a volume left dirty by Windows fast startup is the usual cause"
        kernel_log="; journalctl -k -b | tail"
    fi

    while read -r mount_point; do
        # fstab writes a space as `\040`; umount, mount and findmnt want the
        # path itself (docs/gotchas.md § A mount point with a space was never
        # remounted).
        mount_point=$(unescape_fstab_field "$mount_point")
        mounted=$(mount_fstype "$mount_point")

        # install_fstab's daemon-reload already armed it with the new type.
        if [ "$mounted" = autofs ]; then
            echo "$mount_point is armed by systemd's automount: the next access mounts it" \
                "with $to"
            continue
        fi

        if [ -z "$mounted" ]; then
            continue
        fi

        if ! umount "$mount_point" 2> /dev/null; then
            echo "$mount_point is busy: it keeps its $(mount_fstype "$mount_point") mount" \
                "until the next boot"
            continue
        fi

        if ! error=$(mount "$mount_point" 2>&1); then
            exit_with_error "$mount_point unmounted but the $to driver refused it" \
                "($(reason_on_one_line "$error")$kernel_log; $cause):" \
                "ujust setup-ntfsplus" \
                "$revert puts the row back; the rows after it keep their driver until the" \
                "next boot, and the volume stays unmounted until sudo mount" \
                "$(printf '%q' "$mount_point") or a reboot"
        fi

        echo "remounted $mount_point as $(mount_fstype "$mount_point")"
    done <<< "$mount_points"
}

# switch_fstab_rows <from> <to>: status 1 when the rewritten table was
# refused or could not be written, fstab untouched; the caller unwinds what
# it wrote before. Called under `if !`, which suspends `set -e`: each step
# checks its own status. It ends the run itself only where nothing is left to
# unwind: a volume the new driver refuses after its row changed
# (remount_switched_rows) and a daemon-reload that fails after the write
# (install_fstab). Both directions run through here and only enable leaves
# the backup behind, so naming it is enable's line, not this one's.
switch_fstab_rows() {
    local from=$1 to=$2 mount_points rewritten

    mount_points=$(mount_points_to_rewrite /etc/fstab "$from" "$to")

    if [ -z "$mount_points" ]; then
        echo "fstab: no row to rewrite to $to"
        return 0
    fi

    if ! rewritten=$(mktemp); then
        echo "fstab: mktemp failed"
        return 1
    fi

    if ! replace_fstab_type "$from" "$to" /etc/fstab "$rewritten"; then
        rm -f "$rewritten"
        echo "fstab: the rewrite failed"
        return 1
    fi

    if ! install_fstab "$rewritten" "$from"; then
        return 1
    fi

    rm -f "$rewritten"
    echo "fstab: $(wc -l <<< "$mount_points") row(s) rewritten to $to"

    remount_switched_rows "$mount_points" "$to"
    return 0
}

# --- enable -------------------------------------------------------------------

# Only an opt-in this run wrote is removed: a host that opted in earlier has
# ntfs rows in fstab already, and removing the mask would leave them
# unmountable.
roll_back_enable() {
    local reason=$1

    if [ "$opt_in_written_by_this_run" -eq 1 ]; then
        rm -f "$NTFSPLUS_OPTIN"
        modprobe -r "$MODULE" 2> /dev/null || true
        exit_with_error "$reason: opt-in withdrawn, driver unloaded, fstab untouched"
    fi

    exit_with_error "$reason: the opt-in predates this run and fstab may carry ntfs rows:" \
        "ujust setup-ntfsplus disable, or fix the driver and run enable again; after" \
        "disable a volume the boot did not mount stays unmounted until sudo mount" \
        "<point> or a reboot"
}

write_opt_in() {
    if ntfsplus_optin; then
        echo "opt-in already active"
        return 0
    fi

    if ! ntfsplus_optin_text 2> /dev/null > "$NTFSPLUS_OPTIN.new"; then
        exit_with_error "cannot write $NTFSPLUS_OPTIN.new"
    fi

    if ! mv -f "$NTFSPLUS_OPTIN.new" "$NTFSPLUS_OPTIN" 2> /dev/null; then
        exit_with_error "cannot write $NTFSPLUS_OPTIN"
    fi

    opt_in_written_by_this_run=1
    echo "opt-in written: $NTFSPLUS_OPTIN"
}

enable_ntfsplus() {
    local reason error

    require_root enable setup-ntfsplus

    if [ -z "$(module_path)" ]; then
        exit_with_error "this image carries no ntfsplus module for kernel $(uname -r)"
    fi

    opt_in_written_by_this_run=0
    write_opt_in

    # The mask must work through the kernel's own route before anything else:
    # at boot the fstab units mount by type and the kernel asks for fs-ntfs.
    if ! ntfs_alias_resolves; then
        reason="$NTFSPLUS_OPTIN does not mask the image's blacklist (modprobe -c | grep ntfs)"
        roll_back_enable "$reason"
    fi

    echo "mask verified: the alias fs-ntfs resolves to $(module_path)"

    if ! error=$(modprobe "$MODULE" 2>&1) || ! ntfs_registered; then
        reason="modprobe $MODULE did not register the ntfs type"
        reason+=" ($(reason_on_one_line "$error"); journalctl -k -b | tail); the image's"
        reason+=" copy is unsigned, so a rejected key means Secure Boot is on (bootctl status)"
        roll_back_enable "$reason"
    fi

    echo "driver loaded: ntfs registered"

    if ! run_runtime_probe; then
        roll_back_enable "the runtime probe failed"
    fi

    if ! switch_fstab_rows ntfs3 ntfs; then
        roll_back_enable "fstab was not rewritten"
    fi

    if [ -e "$BACKUP" ]; then
        echo "fstab: the table before the first rewrite is kept at $BACKUP" \
            "(edits made since are not in it; disable removes it)"
    fi

    echo "NTFSPLUS enabled: type ntfs in fstab is the kernel driver from now on" \
        "(ujust setup-ntfsplus disable reverts)"
}

# --- disable ------------------------------------------------------------------

disable_ntfsplus() {
    require_root disable setup-ntfsplus

    if ! ntfsplus_optin && [ -z "$(fstab_rows_of_type /etc/fstab ntfs)" ]; then
        echo "nothing to do: no opt-in and no ntfs row in fstab"
        return 0
    fi

    # The same guard ujust migrate puts before this rewrite: without ntfs3 on
    # the running kernel the rows would come back unmounted after the reboot.
    if ! ntfs3_available; then
        exit_with_error "ntfs3 is not loadable on the running kernel:" \
            "the rewrite would leave the volumes unmounted after the reboot"
    fi

    if ! switch_fstab_rows ntfs ntfs3; then
        exit_with_error "fstab was not rewritten: the opt-in and fstab stay as they were"
    fi

    rm -f "$NTFSPLUS_OPTIN" "$BACKUP"

    if ntfs_registered; then
        if modprobe -r "$MODULE" 2> /dev/null; then
            echo "driver unloaded"
        else
            echo "driver still in use (a volume still mounted as ntfs): unloaded at the next boot"
        fi
    fi

    echo "NTFSPLUS disabled: opt-in and $BACKUP removed, fstab on ntfs3"
}

# --- self-test ----------------------------------------------------------------
#
# Called by tests/55-ntfsplus.sh in the build. Everything runs on files under
# a temporary directory: an fstab with every row type, a status fixture with
# its cmd/mounts list, a stub modprobe, two findmnt stubs (a failed read and an
# empty answer) and umount/mount functions that record the remount cases.
# Every known-bad case is one the real code once got wrong.

self_test_failed() {
    local message=$1
    shift

    echo "self-test: $message"

    if [ $# -gt 0 ]; then
        printf '%s\n' "$@"
    fi

    exit 1
}

write_self_test_fstab() {
    cat > "$1" << 'EOF'
# comment with ntfs3 in it
UUID=1111 / btrfs subvol=root,compress=zstd:1 0 0
UUID=2222 /run/media/x/Windows ntfs3 defaults,nofail,uid=1000,umask=000
UUID=3333 /mnt/games   ntfs3   nofail,x-systemd.device-timeout=10 0 0
UUID=4444 /mnt/fuse ntfs-3g defaults,nofail 0 0
UUID=5555 /mnt/plus ntfs defaults,nofail 0 0
UUID=6666 /mnt/bare ntfs3
UUID=7777 /mnt/bare-plus ntfs
   UUID=8888 /mnt/indented ntfs3 defaults,nofail 0 0
UUID=9999 /mnt/hand ntfs errors=remount-ro,nofail 0 0
UUID=aaaa /mnt/hand2 ntfs nofail,errors=remount-ro,uid=1000 0 0
EOF
}

write_self_test_fstab_plus() {
    cat > "$1" << 'EOF'
# comment with ntfs3 in it
UUID=1111 / btrfs subvol=root,compress=zstd:1 0 0
UUID=2222 /run/media/x/Windows ntfs defaults,nofail,uid=1000,umask=000,errors=remount-ro
UUID=3333 /mnt/games   ntfs   nofail,x-systemd.device-timeout=10,errors=remount-ro 0 0
UUID=4444 /mnt/fuse ntfs-3g defaults,nofail 0 0
UUID=5555 /mnt/plus ntfs defaults,nofail,errors=remount-ro 0 0
UUID=6666 /mnt/bare ntfs errors=remount-ro
UUID=7777 /mnt/bare-plus ntfs errors=remount-ro
   UUID=8888 /mnt/indented ntfs defaults,nofail,errors=remount-ro 0 0
UUID=9999 /mnt/hand ntfs errors=remount-ro,nofail 0 0
UUID=aaaa /mnt/hand2 ntfs nofail,errors=remount-ro,uid=1000 0 0
EOF
}

self_test_fstab_rewrites() {
    local dir=$1

    write_self_test_fstab "$dir/fstab"

    # ntfs3 -> ntfs switches the type column of ntfs3 rows and gives every
    # ntfs row without errors= the option, as the last option or as the
    # options of a row that ends at its type; every other byte stays.
    replace_fstab_type ntfs3 ntfs "$dir/fstab" "$dir/plus"
    write_self_test_fstab_plus "$dir/expected"

    if ! cmp -s "$dir/expected" "$dir/plus"; then
        self_test_failed "ntfs3 -> ntfs gave another table:" \
            "$(diff "$dir/expected" "$dir/plus" || true)"
    fi

    # The rows remounted are the rows the rewrite changes.
    if [ "$(mount_points_to_rewrite "$dir/fstab" ntfs3 ntfs | tr '\n' ' ')" \
        != '/run/media/x/Windows /mnt/games /mnt/plus /mnt/bare /mnt/bare-plus /mnt/indented ' ] \
        || [ "$(mount_points_to_rewrite "$dir/plus" ntfs ntfs3 | grep -c '')" -ne 8 ]; then
        self_test_failed "mount_points_to_rewrite names other rows than the rewrite changes"
    fi

    # ntfs -> ntfs3 reverses it; the ntfs-3g row, the comment and the root
    # row are not rows of either type.
    replace_fstab_type ntfs ntfs3 "$dir/plus" "$dir/back"

    # ntfs3 refuses errors=remount-ro, first, middle or last option of a row.
    if grep -q 'errors=' "$dir/back" \
        || ! grep -qx 'UUID=9999 /mnt/hand ntfs3 nofail 0 0' "$dir/back" \
        || ! grep -qx 'UUID=aaaa /mnt/hand2 ntfs3 nofail,uid=1000 0 0' "$dir/back"; then
        self_test_failed "ntfs -> ntfs3 left errors=remount-ro in a row:" "$(cat "$dir/back")"
    fi

    if ! grep -q '^UUID=4444 /mnt/fuse ntfs-3g ' "$dir/back" \
        || ! grep -q '^# comment with ntfs3 in it$' "$dir/back" \
        || ! grep -q '^UUID=1111 / btrfs ' "$dir/back"; then
        self_test_failed "an ntfs-3g row, a comment or the root row was touched"
    fi

    # The round trip from an all-ntfs3 file is the identity.
    replace_fstab_type ntfs ntfs3 "$dir/fstab" "$dir/norm"
    replace_fstab_type ntfs3 ntfs "$dir/norm" "$dir/plus2"
    replace_fstab_type ntfs ntfs3 "$dir/plus2" "$dir/back2"

    if ! cmp -s "$dir/norm" "$dir/back2"; then
        self_test_failed "ntfs3 -> ntfs -> ntfs3 is not the identity"
    fi

    # A CRLF table keeps its `\r` after the option a row ending at its type gains.
    sed 's/$/\r/' "$dir/fstab" > "$dir/crlf"
    sed 's/$/\r/' "$dir/expected" > "$dir/crlf-expected"
    sed 's/$/\r/' "$dir/norm" > "$dir/crlf-norm"
    replace_fstab_type ntfs3 ntfs "$dir/crlf" "$dir/crlf-plus"
    replace_fstab_type ntfs ntfs3 "$dir/crlf-plus" "$dir/crlf-back"

    if ! cmp -s "$dir/crlf-expected" "$dir/crlf-plus" \
        || ! cmp -s "$dir/crlf-norm" "$dir/crlf-back"; then
        self_test_failed "a CRLF table lost or moved a \\r in the rewrites"
    fi

    if [ "$(count_rows_of_type "$dir/fstab" ntfs3)" -ne 4 ] \
        || [ "$(count_rows_of_type "$dir/fstab" ntfs-3g)" -ne 1 ]; then
        self_test_failed "fstab_rows_of_type miscounts"
    fi

    # A `#` inside the source field is a byte of the field, not a comment:
    # libmount reads the row, so the rewrite reaches it and leaves the
    # commented row alone.
    printf '%s\n' 'LABEL=Disco#2 /mnt/Disco2 ntfs3 defaults 0 0' \
        '#LABEL=Old /mnt/old ntfs3 defaults 0 0' > "$dir/hash"
    replace_fstab_type ntfs3 ntfs "$dir/hash" "$dir/hash-plus"

    if ! grep -qx 'LABEL=Disco#2 /mnt/Disco2 ntfs defaults,errors=remount-ro 0 0' "$dir/hash-plus" \
        || ! grep -qx '#LABEL=Old /mnt/old ntfs3 defaults 0 0' "$dir/hash-plus"; then
        self_test_failed "a # in the source field was skipped or a comment was rewritten:" \
            "$(cat "$dir/hash-plus")"
    fi
}

# Known-bad: a mount point written as `/mnt/games\040disk` reached umount and
# mount escaped, findmnt found nothing there and the volume was skipped in
# silence. Known-bad: an untriggered automount, `autofs` at its point, was
# unmounted and mounted directly. The stubs record the paths they receive.
self_test_remount_unescapes_mount_point() {
    local fixture=$1/remount log=$1/remount.log

    mkdir -p "$fixture/cmd"
    printf '%s\n' '/mnt/games disk ntfs3' '/mnt/ext autofs' > "$fixture/cmd/mounts"
    : > "$log"
    (
        umount() { echo "umount $1" >> "$log"; }
        mount() { echo "mount $1" >> "$log"; }
        FIXTURE=$fixture remount_switched_rows $'/mnt/games\\040disk\n/mnt/ext' ntfs > /dev/null
    )

    if [ "$(cat "$log")" != $'umount /mnt/games disk\nmount /mnt/games disk' ]; then
        self_test_failed "a \\040 mount point was not remounted by its real path, or the" \
            "automount at /mnt/ext was:" "$(cat "$log")"
    fi
}

# Known-bad: the refusal of an ntfs row blamed a dirty volume, which NTFSPLUS
# mounts, and sent the reader to the kernel log, where mount(8)'s reason is not.
self_test_remount_names_the_refused_option() {
    local fixture=$1/refused output
    local expected="^ERROR: /mnt/win unmounted but the ntfs driver refused it (mount: .*"
    expected+="'prealloc'.*; the reason names the option NTFSPLUS refused):"

    mkdir -p "$fixture/cmd"
    printf '/mnt/win ntfs3\n' > "$fixture/cmd/mounts"

    if output=$(
        umount() { :; }
        mount() {
            echo "mount: $1: fsconfig() failed: ntfs: Unknown parameter 'prealloc'." >&2
            return 32
        }
        FIXTURE=$fixture remount_switched_rows /mnt/win ntfs 2>&1
    ); then
        self_test_failed "a remount the driver refused passed:" "$output"
    fi

    if ! grep -q "$expected" <<< "$output" || grep -q 'dirty' <<< "$output"; then
        self_test_failed "a refused ntfs remount does not name mount's reason alone:" "$output"
    fi
}

# Known-bad: `\x20` and `\c` are not escapes and stay, which printf '%b'
# would not honour.
self_test_unescape_fstab_field() {
    local decoded

    decoded=$(unescape_fstab_field '/mnt/games\040disk')

    if [ "$decoded" != '/mnt/games disk' ]; then
        self_test_failed "unescape_fstab_field on \\040: $decoded"
    fi

    decoded=$(unescape_fstab_field '/mnt/a\012b')

    if [ "$(printf '%s' "$decoded" | wc -c)" -ne 8 ]; then
        self_test_failed "unescape_fstab_field on \\012: $(printf '%s' "$decoded" | od -c)"
    fi

    decoded=$(unescape_fstab_field '/mnt/a\x20b\c')

    if [ "$decoded" != '/mnt/a\x20b\c' ]; then
        self_test_failed "unescape_fstab_field decoded a non-escape: $decoded"
    fi
}

# Known-bad: `findmnt … 2> /dev/null || true` read every failure as a host
# with nothing mounted, so `mounted: none` stood for an answer never read;
# then `[ status -gt 1 ]` let exit 1 through, which findmnt(8) gives on ANY
# error (`can't read /proc/self/mountinfo`), no match being exit 0 with
# nothing printed. The stubs: an error with exit 1, and a clean empty answer.
self_test_status_refuses_an_unreadable_mount_table() {
    local stubs=$1/findmnt-stub out status
    local expected='^ERROR: cannot read the mounted NTFS volumes: findmnt: stub broken$'

    mkdir -p "$stubs"
    printf '#!/usr/bin/env bash\necho "findmnt: stub broken" >&2\nexit 1\n' > "$stubs/findmnt"
    chmod 755 "$stubs/findmnt"

    if out=$(FIXTURE='' PATH=$stubs:$PATH src_ntfs_mounts 2>&1); then
        status=0
    else
        status=$?
    fi

    if [ "$status" -ne 1 ]; then
        self_test_failed "src_ntfs_mounts passed on a findmnt that cannot read:" "$out"
    fi

    if ! grep -q "$expected" <<< "$out"; then
        self_test_failed "src_ntfs_mounts did not name the findmnt failure:" "$out"
    fi

    printf '#!/usr/bin/env bash\nexit 0\n' > "$stubs/findmnt"

    if out=$(FIXTURE='' PATH=$stubs:$PATH src_ntfs_mounts 2>&1); then
        status=0
    else
        status=$?
    fi

    if [ "$status" -ne 0 ] || [ -n "$out" ]; then
        self_test_failed "src_ntfs_mounts read no match as a failure (status $status):" "$out"
    fi
}

self_test_status_on_fixture() {
    local dir=$1 fixture=$1/fx output

    mkdir -p "$fixture/etc/modprobe.d" "$fixture/proc" "$fixture/cmd"
    cp "$dir/fstab" "$fixture/etc/fstab"
    printf 'nodev\tbtrfs\n\tntfs3\n' > "$fixture/proc/filesystems"
    : > "$fixture/cmd/mounts"

    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^opt-in: not active' <<< "$output" \
        || ! grep -q '^driver ntfs: not registered' <<< "$output" \
        || ! grep -q '^fstab ntfs3: /run/media/x/Windows /mnt/games /mnt/bare /mnt/indented$' \
            <<< "$output" \
        || ! grep -q '^fstab ntfs: /mnt/plus /mnt/bare-plus /mnt/hand /mnt/hand2$' <<< "$output" \
        || ! grep -q '^mounted: none$' <<< "$output"; then
        self_test_failed "status on the fixture:" "$output"
    fi

    # Known-bad: `mounted:` stood alone over nothing when findmnt listed
    # nothing; a listing is indented under it.
    printf '/mnt/games disk ntfs3\n/ btrfs\n' > "$fixture/cmd/mounts"
    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^mounted:$' <<< "$output" \
        || ! grep -q '^  /mnt/games disk ntfs3$' <<< "$output" \
        || grep -q 'btrfs' <<< "$output"; then
        self_test_failed "status with a mounted volume:" "$output"
    fi

    : > "$fixture/cmd/mounts"

    # Known-bad: on a CRLF table a row that ends at its type read as `ntfs3\r`
    # and left the list.
    sed 's/$/\r/' "$dir/fstab" > "$fixture/etc/fstab"
    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^fstab ntfs3: /run/media/x/Windows /mnt/games /mnt/bare /mnt/indented$' \
        <<< "$output" \
        || ! grep -q '^fstab ntfs: /mnt/plus /mnt/bare-plus /mnt/hand /mnt/hand2$' \
            <<< "$output"; then
        self_test_failed "status on the CRLF fixture:" "$output"
    fi

    # Known-bad: a point with a space printed as fstab writes it, `\040`,
    # while the mounted: line and verify-host print it as libmount reads it.
    printf 'UUID=9999 /mnt/sp\\040ace ntfs3 defaults,nofail 0 0\n' > "$fixture/etc/fstab"
    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^fstab ntfs3: /mnt/sp ace$' <<< "$output"; then
        self_test_failed "status on a point with a space:" "$output"
    fi

    # Known-bad: a type with no row printed an empty list instead of `none`.
    echo 'UUID=1111 / btrfs subvol=root 0 0' > "$fixture/etc/fstab"
    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^fstab ntfs3: none$' <<< "$output" \
        || ! grep -q '^fstab ntfs: none$' <<< "$output" \
        || ! grep -q '^fstab ntfs-3g: none$' <<< "$output"; then
        self_test_failed "status on a table without NTFS rows:" "$output"
    fi

    cp "$dir/fstab" "$fixture/etc/fstab"

    ntfsplus_optin_text > "$fixture/etc/modprobe.d/bazzite-mx-ntfsplus.conf"
    printf 'nodev\tbtrfs\n\tntfs3\n\tntfs\n' > "$fixture/proc/filesystems"

    output=$(FIXTURE=$fixture show_status)

    if ! grep -q '^opt-in: active' <<< "$output" \
        || ! grep -q '^driver ntfs: registered' <<< "$output"; then
        self_test_failed "status on the opted-in fixture:" "$output"
    fi
}

# A modprobe whose config is 50 000 alias lines, `blacklist ntfs` first under
# STUB_BLACKLIST (the size is the point: docs/gotchas.md § `command | grep
# -q` under `pipefail` fails on a match). Its dry run prints insmod under
# STUB_INSMOD; under STUB_LOADED only for --show-depends, as for a loaded
# module.
write_modprobe_stub() {
    cat > "$1" << 'STUB'
#!/usr/bin/env bash
case " $* " in
    *" -c "*)
        if [ -n "${STUB_BLACKLIST:-}" ]; then
            echo "blacklist ntfs"
        fi

        yes "alias pci:v00001234d00005678sv*sd*bc*sc*i* stub" | head -n 50000
        ;;
    *" fs-ntfs "*)
        if [ -n "${STUB_LOADED:-}" ]; then
            case " $* " in
                *" --show-depends "*)
                    echo "insmod /lib/modules/x/updates/ntfs.ko "
                    ;;
            esac
        elif [ -n "${STUB_INSMOD:-}" ]; then
            echo "insmod /lib/modules/x/updates/ntfs.ko "
        fi
        ;;
esac
STUB
    chmod +x "$1"
}

self_test_alias_resolves() {
    local dir=$1

    mkdir -p "$dir/bin"
    write_modprobe_stub "$dir/bin/modprobe"

    if PATH=$dir/bin:$PATH STUB_BLACKLIST=1 STUB_INSMOD=1 ntfs_alias_resolves; then
        self_test_failed "ntfs_alias_resolves reads a blacklisted module as resolving"
    fi

    if ! PATH=$dir/bin:$PATH STUB_INSMOD=1 ntfs_alias_resolves; then
        self_test_failed "ntfs_alias_resolves refuses a free alias whose dry run prints insmod"
    fi

    if PATH=$dir/bin:$PATH ntfs_alias_resolves; then
        self_test_failed "ntfs_alias_resolves reads an empty dry run as resolving"
    fi

    if ! PATH=$dir/bin:$PATH STUB_LOADED=1 ntfs_alias_resolves; then
        self_test_failed "ntfs_alias_resolves refuses a free alias whose module is already loaded"
    fi
}

self_test() {
    local dir

    dir=$(mktemp -d)
    # shellcheck disable=SC2064  # expand now: the local is gone at EXIT
    trap "rm -rf '$dir'" EXIT

    self_test_fstab_rewrites "$dir"
    self_test_unescape_fstab_field
    self_test_remount_unescapes_mount_point "$dir"
    self_test_remount_names_the_refused_option "$dir"
    self_test_status_on_fixture "$dir"
    self_test_status_refuses_an_unreadable_mount_table "$dir"
    self_test_alias_resolves "$dir"

    echo "self-test ok: fstab rewrites exact both ways, ntfs-3g row and comment untouched," \
        "round trip identity, remount by the unescaped point and none of an automount," \
        "a refused remount named by mount's reason, fields unescaped, status from LF and CRLF" \
        "fixtures, status refused on a findmnt that cannot read the mounts, alias probe right" \
        "on 4 modprobe stubs"
}

# --- main ---------------------------------------------------------------------

case "${1:-status}" in
    status)
        show_status
        ;;
    enable)
        enable_ntfsplus
        ;;
    disable)
        disable_ntfsplus
        ;;
    --self-test)
        self_test
        ;;
    *)
        exit_with_error "unknown command '${1:-}' (usage: bazzite-mx-ntfsplus-setup status |" \
            "enable | disable | --self-test)"
        ;;
esac
