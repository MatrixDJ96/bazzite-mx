#!/usr/bin/env bash
# Move a host from a Bazzite-style deployment (unsigned transport, layered
# packages, local initramfs, NTFS volumes on the `ntfs` driver) to the state
# this image expects, in one pending deployment, one confirmation per
# mutating step, the reboot left to the user. The root half of `ujust migrate`.
#
# Usage: bazzite-mx-migrate plan [TAG]            read-only: what apply would do
#        bazzite-mx-migrate apply [TAG]           do it, asking before every change
#        bazzite-mx-migrate fstab-rewrite IN OUT  the fstab function alone (tests)
#        bazzite-mx-migrate --self-test           prove plan refuses the bad states
#   TAG defaults to stable; a dated release tag pins the host to that release.
#   FIXTURE=<dir> (plan only): files read under <dir>, command outputs under
#   <dir>/cmd/ (host.sh).
# Exit status: 0 done; 1 failed or refused, `ERROR: …` on stderr; 2 a
#   precondition or a declined step stopped the run, `ABORT: …` on stderr.
# Writes (apply): /var/tmp/bazzite-mx-migrate/<timestamp>/ with the backups,
#   the origin through rpm-ostree, /etc/fstab, /etc/containers when restored.
# Output: the plan's step numbers and the `plan: ready …` line are what the
#   self-test and docs/migration.md read; a message either cites stays as it is.
set -euo pipefail

# shellcheck source=../lib/bazzite-mx/host.sh
source /usr/lib/bazzite-mx/host.sh

SIGNED="ostree-image-signed:docker://$VENDOR_SCOPE"
UNSIGNED="ostree-unverified-registry:$VENDOR_SCOPE"
BACKUP_ROOT=/var/tmp/bazzite-mx-migrate

# Script level, not a local of cmd_apply: the EXIT trap runs after cmd_apply
# has returned, where a local is unbound under set -u and the trap would die
# with uupd.timer left stopped (docs/gotchas.md § An EXIT trap cannot read a
# `local` of the function that armed it).
TIMER_WAS_ACTIVE=0

# Filled by detect_host_state, read by the plan and every apply step.
BOOTED=
PENDING=
REF=
LAYERED=
REGEN=
PINNED=
IMAGE=
TARGET=
SCOPE_OK=0
CONFIG_HITS=
NTFS_ROWS=
OPTIN=0
RESIDUE_FILES=
RESIDUE_KARGS=

# --- stopping, asking, reading the host ---------------------------------------

# A precondition or a declined step: exit 2, distinct from a failure.
abort() {
    echo "ABORT: $*" >&2
    exit 2
}

# confirm <question>: without a terminal nothing is confirmed.
confirm() {
    local question=$1

    if [ -t 0 ]; then
        ugum confirm "$question"
    else
        echo "no terminal: '$question' not confirmed" >&2
        return 1
    fi
}

# The command sources of this helper alone; the shared ones are host.sh's.
src_config_diff() {
    if [ -n "$FIXTURE" ]; then
        cat "$FIXTURE/cmd/config-diff"
    else
        ostree admin config-diff
    fi
}

# Status 0 when the running kernel has ntfs3 registered or loadable; on a
# fixture only the registered case counts.
ntfs3_available() {
    if grep -qw ntfs3 "$(host_file /proc/filesystems)"; then
        return 0
    fi

    if [ -n "$FIXTURE" ]; then
        return 1
    fi

    modprobe -n ntfs3 2> /dev/null
}

# --- fstab --------------------------------------------------------------------

# rewrite_fstab_ntfs_to_ntfs3 <in> <out>: the type column `ntfs` becomes
# `ntfs3`, everything else byte for byte.
rewrite_fstab_ntfs_to_ntfs3() {
    local input=$1
    local output=$2
    local device_and_mount_point='^([^#[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+)'

    sed -E "s/${device_and_mount_point}ntfs([[:space:]])/\\1ntfs3\\2/" "$input" > "$output"
}

ntfs_rows() {
    local fstab=$1

    fstab_entries "$fstab" | awk '$3 == "ntfs"'
}

# --- what the host has --------------------------------------------------------

detect_deployment() {
    local status
    local pending_version='if .deployments[0].booted == true then ""
        else (.deployments[0].version // .deployments[0].checksum) end'

    status=$(src_rpm_ostree_status)
    BOOTED=$(booted_deployment "$status")
    if [ -z "$BOOTED" ]; then
        exit_with_error "rpm-ostree status lists no booted deployment"
    fi

    PENDING=$(jq -r "$pending_version" <<< "$status")
    REF=$(jq -r '."container-image-reference" // ""' <<< "$BOOTED")
    LAYERED=$(layered_requests "$BOOTED")
    REGEN=$(jq -r '."regenerate-initramfs" // false' <<< "$BOOTED")
    PINNED=$(jq -r '.pinned // false' <<< "$BOOTED")
}

# `M` modified, `A` added: a local copy in /etc shadows the image's file,
# which the three-way merge never replaces.
detect_image_and_policy() {
    IMAGE=$(image_name)
    if [ -z "$IMAGE" ]; then
        exit_with_error "$(host_file $IMAGE_INFO) unreadable:" \
            "the booted image is not a bazzite-mx image"
    fi
    TARGET="$SIGNED/$IMAGE:$TAG"

    SCOPE_OK=0
    if [ "$(policy_scope_type)" = sigstoreSigned ]; then
        SCOPE_OK=1
    fi

    CONFIG_HITS=$(src_config_diff \
        | grep -E '^[MA][[:space:]]+containers/(policy\.json|registries\.d/)' || true)
}

detect_fstab_and_residue() {
    NTFS_ROWS=$(ntfs_rows "$(host_file /etc/fstab)")

    OPTIN=0
    if ntfsplus_optin; then
        OPTIN=1
    fi

    RESIDUE_FILES=$({
        ntfsplus_files
        msi_files
    } | sort -u)
    RESIDUE_KARGS=$(ntfsplus_kargs)
}

# Fills the globals every step reads; apply calls it again after step 0.
detect_host_state() {
    detect_deployment
    detect_image_and_policy
    detect_fstab_and_residue
}

# --- the plan -----------------------------------------------------------------

# The values the summary prints for the states that are not plain strings.

scope_state() {
    if [ "$SCOPE_OK" -eq 1 ]; then
        echo present
    else
        echo MISSING
    fi
}

optin_state() {
    if [ "$OPTIN" -eq 1 ]; then
        echo active
    else
        echo none
    fi
}

ntfs_mount_points() {
    if [ -n "$NTFS_ROWS" ]; then
        awk '{ print $2 }' <<< "$NTFS_ROWS" | tr '\n' ' '
    else
        echo none
    fi
}

residue_on_one_line() {
    printf '%s %s' "$(tr '\n' ' ' <<< "$RESIDUE_FILES")" "$(tr '\n' ' ' <<< "$RESIDUE_KARGS")" \
        | sed 's/^ *//;s/ *$//'
}

print_host_summary() {
    echo "bazzite-mx migrate: plan for $IMAGE, target $TARGET"
    echo
    printf '  %-28s %s\n' "booted origin" "$REF"
    printf '  %-28s %s\n' "pending deployment" "${PENDING:-none}"
    printf '  %-28s %s\n' "layered / local packages" "${LAYERED:-none}"
    printf '  %-28s %s\n' "local initramfs" "$REGEN"
    printf '  %-28s %s\n' "booted deployment pinned" "$PINNED"
    printf '  %-28s %s\n' "policy scope $VENDOR_SCOPE" "$(scope_state)"
    printf '  %-28s %s\n' "local policy/registries.d" "${CONFIG_HITS:-none}"
    printf '  %-28s %s\n' "fstab ntfs rows" "$(ntfs_mount_points)"
    printf '  %-28s %s\n' "ntfsplus opt-in" "$(optin_state)"
    printf '  %-28s %s\n' "residue" "$(residue_on_one_line)"
    echo
}

# No step 1: it is the scope precondition, checked between 0 and 2
# (docs/migration.md).
print_steps() {
    local already_pinned="" residue_files residue_kargs

    if [ "$PINNED" = true ]; then
        already_pinned=' (already pinned)'
    fi

    echo "steps apply would run:"
    if [ -n "$CONFIG_HITS" ]; then
        echo "  0. restore /etc/containers/policy.json and registries.d from the image" \
            "(/usr/etc), backup under $BACKUP_ROOT"
    fi
    echo "  2. back up status and fstab under $BACKUP_ROOT;" \
        "ostree admin pin booted$already_pinned; uupd.timer stopped meanwhile"

    if [ -n "$LAYERED" ]; then
        echo "  3. rpm-ostree uninstall --all  ($LAYERED)"
    else
        echo "  3. (nothing layered: skipped)"
    fi

    if [ "$REGEN" = true ]; then
        echo "  4. rpm-ostree initramfs --disable"
    else
        echo "  4. (initramfs already the image's: skipped)"
    fi

    if [ "$REF" != "$TARGET" ]; then
        echo "  5. rpm-ostree rebase $TARGET"
    else
        echo "  5. (origin already $TARGET: skipped)"
    fi

    if [ "$OPTIN" -eq 1 ]; then
        echo "  6. (ntfsplus opt-in active: fstab kept, ujust setup-ntfsplus manages its rows)"
    elif [ -n "$NTFS_ROWS" ]; then
        echo "  6. /etc/fstab: type ntfs -> ntfs3 on $(wc -l <<< "$NTFS_ROWS") row(s)," \
            "options untouched; daemon-reload; findmnt --verify"
    else
        echo "  6. (no ntfs row in fstab: skipped)"
    fi

    if [ -n "$RESIDUE_FILES$RESIDUE_KARGS" ]; then
        residue_files=$(tr '\n' ' ' <<< "$RESIDUE_FILES")
        residue_kargs=$(tr '\n' ' ' <<< "$RESIDUE_KARGS")
        echo "  6b. remove residue: $residue_files$residue_kargs"
    fi
    echo "  7. print the per-user Firefox profile copy, the Teams Flatpak, reboot, rollback" \
        "and unpin"
}

print_plan() {
    print_host_summary
    print_steps
}

# Conditions that stop both plan and apply, after the plan is printed. The
# signed pull is checked against the running deployment's policy, so an image
# predating that policy is reached once through the unsigned transport.
check_preconditions() {
    if [ -n "$PENDING" ]; then
        abort "a pending deployment ($PENDING) exists: rpm-ostree would queue these changes" \
            "on it. Reboot into it or run 'rpm-ostree cleanup -p', then start again"
    fi

    if [ "$SCOPE_OK" -eq 1 ]; then
        return 0
    fi

    if [ -n "$CONFIG_HITS" ]; then
        abort "/etc/containers carries a local copy ($(paste -sd ' ' <<< "$CONFIG_HITS")):" \
            "the image's policy never reaches /etc through the merge." \
            "apply offers the restore from /usr/etc; run it first"
    fi

    abort "the booted image has no signing policy for $VENDOR_SCOPE (an image predating the" \
        "policy). Reach this image through the unsigned transport once, then reboot and run" \
        "this again:
  sudo rpm-ostree rebase $UNSIGNED/$IMAGE:$TAG
  systemctl reboot"
}

# --- the apply steps ----------------------------------------------------------

# Every step prints `step N: …` first, then asks; a declined 3, 4 or 5 aborts,
# a declined 0, 6 or 6b only skips (docs/migration.md).

new_backup_directory() {
    local timestamp

    timestamp=$(date -u +%Y%m%dT%H%M%SZ)
    mkdir -p "$BACKUP_ROOT/$timestamp"
    echo "$BACKUP_ROOT/$timestamp"
}

step_0_restore_containers_config() {
    local backup

    if [ -z "$CONFIG_HITS" ]; then
        return 0
    fi

    echo "step 0: local copies in /etc/containers: $(tr '\n' ' ' <<< "$CONFIG_HITS")"
    if ! confirm "Restore policy.json and registries.d from the image (backup kept)?"; then
        return 0
    fi

    backup=$(new_backup_directory)
    cp -a /etc/containers/policy.json "$backup/policy.json"
    cp -a /etc/containers/registries.d "$backup/registries.d"
    cp -a /usr/etc/containers/policy.json /etc/containers/policy.json
    cp -a /usr/etc/containers/registries.d/. /etc/containers/registries.d/
    echo "restored from /usr/etc; backup under $backup"

    detect_host_state
}

# step_2_backup_pin_and_stop_timer: prints the backup directory it created.
step_2_backup_pin_and_stop_timer() {
    local backup

    backup=$(new_backup_directory)
    rpm-ostree status --json > "$backup/rpm-ostree-status.json"
    cp -a /etc/fstab "$backup/fstab"
    echo "step 2: backups under $backup" >&2

    if [ "$PINNED" != true ]; then
        ostree admin pin booted >&2
        echo "step 2: booted deployment pinned (ostree admin pin -u <index> after 24 h of use)" >&2
    fi

    if systemctl is-active --quiet uupd.timer; then
        TIMER_WAS_ACTIVE=1
        systemctl stop uupd.timer
        echo "step 2: uupd.timer stopped for the duration" >&2
    fi

    echo "$backup"
}

step_3_uninstall_layered() {
    if [ -z "$LAYERED" ]; then
        return 0
    fi

    echo "step 3: rpm-ostree uninstall --all ($LAYERED)"
    rpm-ostree uninstall --all --dry-run
    if ! confirm "Remove every layered and local package from the origin?"; then
        abort "step 3 not confirmed; nothing changed beyond the backups and the pin"
    fi

    rpm-ostree uninstall --all
}

step_4_disable_local_initramfs() {
    local question="Stop regenerating the initramfs locally (the image's initramfs boots instead)?"

    if [ "$REGEN" != true ]; then
        return 0
    fi

    echo "step 4: rpm-ostree initramfs --disable"
    if ! confirm "$question"; then
        abort "step 4 not confirmed; the pending deployment keeps the changes made so far"
    fi

    rpm-ostree initramfs --disable
}

step_5_rebase() {
    if [ "$REF" = "$TARGET" ]; then
        return 0
    fi

    echo "step 5: rpm-ostree rebase $TARGET"
    if ! confirm "Rebase to $TARGET (signature verified against the image's policy)?"; then
        abort "step 5 not confirmed; the pending deployment keeps the changes made so far"
    fi

    rpm-ostree rebase "$TARGET"
}

# write_rewritten_fstab <rewritten> <backup>: installs the file, reloads
# systemd and verifies the table; a failed verification names the backup.
write_rewritten_fstab() {
    local rewritten=$1
    local backup=$2

    install -m 0644 -o root -g root "$rewritten" /etc/fstab
    systemctl daemon-reload

    if findmnt --verify --fstab > "$rewritten.verify" 2>&1; then
        echo "findmnt --verify: $(tail -n1 "$rewritten.verify")"
    else
        cat "$rewritten.verify"
        exit_with_error "findmnt --verify --fstab failed: restore $backup/fstab"
    fi
}

step_6_fstab_ntfs_to_ntfs3() {
    local backup=$1
    local rewritten rows_left

    if [ "$OPTIN" -eq 1 ]; then
        echo "step 6: ntfsplus opt-in active: fstab kept (ujust setup-ntfsplus manages its rows)"
        return 0
    fi

    if [ -z "$NTFS_ROWS" ]; then
        return 0
    fi

    echo "step 6: fstab rows on the ntfs driver:"
    echo "$NTFS_ROWS"
    if ! ntfs3_available; then
        abort "ntfs3 is not loadable on the running kernel:" \
            "the fstab change would leave the volumes unmounted after the reboot"
    fi

    rewritten=$(mktemp)
    rewrite_fstab_ntfs_to_ntfs3 /etc/fstab "$rewritten"
    diff -u /etc/fstab "$rewritten" || true

    rows_left=$(ntfs_rows "$rewritten" | grep -c '' || true)
    if [ "$rows_left" -ne 0 ]; then
        exit_with_error "rewrite left $rows_left ntfs row(s)"
    fi

    if confirm "Write this fstab (type column only, backup in $backup)?"; then
        write_rewritten_fstab "$rewritten" "$backup"
    fi

    rm -f "$rewritten" "$rewritten.verify"
}

step_6b_remove_residue() {
    local backup=$1
    local path karg

    if [ -n "$RESIDUE_FILES" ]; then
        echo "step 6b: residue files: $(tr '\n' ' ' <<< "$RESIDUE_FILES")"
        if confirm "Remove them (copies kept under $backup)?"; then
            while IFS= read -r path; do
                if [ -z "$path" ]; then
                    continue
                fi
                mkdir -p "$backup$(dirname "$path")"
                mv "$path" "$backup$path"
            done <<< "$RESIDUE_FILES"
        fi
    fi

    if [ -n "$RESIDUE_KARGS" ]; then
        echo "step 6b: ntfsplus kernel arguments: $(tr '\n' ' ' <<< "$RESIDUE_KARGS")"
        if confirm "Delete them from the pending deployment's kernel arguments?"; then
            while IFS= read -r karg; do
                if [ -z "$karg" ]; then
                    continue
                fi
                rpm-ostree kargs --delete="$karg"
            done <<< "$RESIDUE_KARGS"
        fi
    fi
}

print_step_7_what_stays_with_the_user() {
    echo
    echo "step 7: what stays with the user"
    echo "  - Firefox: the RPM in the image reads ~/.mozilla; a Flatpak profile is copied once," \
        "per user, BEFORE the first RPM start:"
    echo "      [ -d ~/.mozilla ] || cp -a ~/.var/app/org.mozilla.firefox/.mozilla ~/"
    echo "    then, if wanted: flatpak uninstall org.mozilla.firefox"
    echo "  - Teams: flatpak install flathub com.github.IsmaelMartinez.teams_for_linux" \
        "(its config lives in ~/.var/app, not in ~/.config/teams-for-linux)"
    echo "  - reboot:   systemctl reboot"
    echo "  - rollback: rpm-ostree rollback && systemctl reboot" \
        "  (the previous deployment is pinned)"
    echo "  - after 24 h of use: ujust verify-host, then sudo ostree admin pin -u" \
        "<index of the old deployment>"
}

# Armed as the EXIT trap by cmd_apply once the timer has been stopped.
restore_timer() {
    if [ "$TIMER_WAS_ACTIVE" -eq 1 ]; then
        if systemctl start uupd.timer; then
            echo "uupd.timer started again"
        fi
    fi
}

# --- commands -----------------------------------------------------------------

cmd_plan() {
    detect_host_state
    print_plan
    echo

    check_preconditions
    echo "plan: ready for 'ujust migrate apply $TAG'"
}

cmd_apply() {
    local backup

    if [ -n "$FIXTURE" ]; then
        exit_with_error "apply does not run on a fixture"
    fi
    require_root apply migrate

    detect_host_state
    print_plan
    echo

    step_0_restore_containers_config
    check_preconditions

    backup=$(step_2_backup_pin_and_stop_timer)
    trap restore_timer EXIT

    step_3_uninstall_layered
    step_4_disable_local_initramfs
    step_5_rebase
    step_6_fstab_ntfs_to_ntfs3 "$backup"
    step_6b_remove_residue "$backup"

    print_step_7_what_stays_with_the_user
    rpm-ostree status
}

# --- self-test ----------------------------------------------------------------

fail_self_test() {
    echo "self-test: $*"
    exit 1
}

# A fstab with two ntfs rows, an ntfs-3g row, a bind and a comment naming ntfs.
self_test_fstab() {
    local fstab=$1

    cat > "$fstab" << 'FSTAB'
# comment with ntfs in it
UUID=1111 /  btrfs subvol=root 0 0
UUID=2222 /run/media/x/Windows ntfs defaults,nofail,uid=1000,gid=1000,umask=022 0 0
UUID=3333 /mnt/games   ntfs   nofail,x-systemd.device-timeout=10 0 0
/mnt/games/steam /home/x/steam none bind,nofail,x-systemd.requires-mounts-for=/mnt/games 0 0
UUID=4444 /mnt/fuse ntfs-3g defaults,nofail 0 0
FSTAB
}

# Only the type column of the `ntfs` rows changes.
self_test_fstab_rewrite() {
    local dir=$1

    rewrite_fstab_ntfs_to_ntfs3 "$dir/fstab" "$dir/out"

    if ! diff <(sed '/^#/!s/ ntfs / ntfs3 /' "$dir/fstab") "$dir/out" > /dev/null; then
        fail_self_test "fstab rewrite changed more than the type column"
    fi

    if [ "$(ntfs_rows "$dir/out" | grep -c '')" -ne 0 ]; then
        fail_self_test "ntfs rows left after the rewrite"
    fi

    if ! grep -q '^UUID=4444 /mnt/fuse ntfs-3g ' "$dir/out" \
        || ! grep -q '^# comment with ntfs in it$' "$dir/out"; then
        fail_self_test "an ntfs-3g row or a comment was touched"
    fi

    if [ "$(ntfs_rows "$dir/fstab" | grep -c '')" -ne 2 ]; then
        fail_self_test "ntfs_rows counted $(ntfs_rows "$dir/fstab" | grep -c '') rows, expected 2"
    fi
}

# self_test_unmigrated_fixture <dir> <fstab>: a host that already boots this
# image unsigned, with layered packages and a local initramfs, and a pending
# deployment behind the booted one.
self_test_unmigrated_fixture() {
    local fixture=$1
    local fstab=$2

    mkdir -p "$fixture/cmd" "$fixture/etc/containers" "$fixture/etc/modprobe.d" \
        "$fixture/etc/modules-load.d" "$fixture/usr/share/ublue-os" "$fixture/proc"
    cp "$fstab" "$fixture/etc/fstab"
    printf 'nodev\tbtrfs\n\tntfs3\n' > "$fixture/proc/filesystems"
    printf '{"image-name":"bazzite-mx"}\n' > "$fixture/usr/share/ublue-os/image-info.json"
    cat > "$fixture/etc/containers/policy.json" << 'POLICY'
{"default": [{"type": "reject"}],
 "transports": {"docker": {"ghcr.io/matrixdj96": [
   {"type": "sigstoreSigned", "keyPath": "/etc/pki/containers/matrixdj96.pub"}]}}}
POLICY
    printf 'M    fstab\nM    hosts\n' > "$fixture/cmd/config-diff"
    printf 'root=UUID=x rw rhgb quiet\n' > "$fixture/cmd/kargs"
    cat > "$fixture/cmd/rpm-ostree-status.json" << 'STATUS'
{"deployments": [
  {"booted": true, "staged": false,
   "container-image-reference":
     "ostree-unverified-registry:ghcr.io/matrixdj96/bazzite-mx:44.20260903",
   "packages": [], "requested-packages": ["1password"],
   "requested-local-packages": ["teams-for-linux"], "requested-base-removals": [],
   "requested-modules": null, "regenerate-initramfs": true, "initramfs-args": ["--hostonly"],
   "pinned": false, "version": "44.20260903"},
  {"booted": false, "staged": false,
   "container-image-reference": "ostree-unverified-registry:ghcr.io/matrixdj96/bazzite-mx:stable",
   "packages": ["1password"], "regenerate-initramfs": true, "pinned": false,
   "version": "44.20260902"}]}
STATUS
}

# self_test_migrated_status <file>: the booted deployment of a migrated host,
# signed, nothing layered, the image's initramfs, pinned.
self_test_migrated_status() {
    local file=$1

    cat > "$file" << 'STATUS'
{"deployments": [
  {"booted": true, "staged": false,
   "container-image-reference": "ostree-image-signed:docker://ghcr.io/matrixdj96/bazzite-mx:stable",
   "packages": [], "regenerate-initramfs": false, "pinned": true, "version": "44.20260903"}]}
STATUS
}

self_test_plan_lists_the_steps() {
    local fixture=$1
    local rebase_step="5. rpm-ostree rebase $SIGNED/bazzite-mx:44.20260903"
    local out

    if ! out=$(FIXTURE=$fixture TAG=44.20260903 cmd_plan); then
        fail_self_test "plan failed on the good fixture: $out"
    fi

    if ! grep -q '3. rpm-ostree uninstall --all  (1password teams-for-linux)' <<< "$out" \
        || ! grep -q '4. rpm-ostree initramfs --disable' <<< "$out" \
        || ! grep -qF "$rebase_step" <<< "$out" \
        || ! grep -q '6. /etc/fstab: type ntfs -> ntfs3 on 2 row(s)' <<< "$out" \
        || ! grep -q "plan: ready for 'ujust migrate apply 44.20260903'" <<< "$out"; then
        echo "self-test: the plan does not list the expected steps:"
        echo "$out"
        exit 1
    fi
}

# Known-bad 1: a pending deployment (the first becomes staged, the second booted).
self_test_plan_refuses_pending() {
    local good=$1
    local fixture=$2
    local swap_deployments='.deployments[0].booted = false | .deployments[0].staged = true
        | .deployments[1].booted = true'
    local out

    mkdir -p "$fixture"
    cp -a "$good/." "$fixture/"
    jq "$swap_deployments" "$good/cmd/rpm-ostree-status.json" \
        > "$fixture/cmd/rpm-ostree-status.json"

    if out=$(FIXTURE=$fixture TAG=stable cmd_plan 2>&1); then
        fail_self_test "a pending deployment did not abort the plan"
    fi

    if ! grep -q 'ABORT: a pending deployment (44.20260903)' <<< "$out"; then
        fail_self_test "pending abort message wrong: $(tail -n1 <<< "$out")"
    fi
}

# Known-bad 2 and 3: no signing scope in the booted policy, then a local
# policy.json shadowing the image's.
self_test_plan_refuses_missing_scope() {
    local good=$1
    local fixture=$2
    local unsigned_rebase="rpm-ostree rebase $UNSIGNED/bazzite-mx:stable"
    local local_copy_abort='ABORT: /etc/containers carries a local copy'
    local out

    local_copy_abort="$local_copy_abort (M    containers/policy.json)"
    mkdir -p "$fixture"
    cp -a "$good/." "$fixture/"
    cat > "$fixture/etc/containers/policy.json" << 'POLICY'
{"default": [{"type": "reject"}],
 "transports": {"docker": {"ghcr.io/ublue-os": [{"type": "sigstoreSigned"}]}}}
POLICY

    if out=$(FIXTURE=$fixture TAG=stable cmd_plan 2>&1); then
        fail_self_test "a missing policy scope did not abort the plan"
    fi

    if ! grep -qF "$unsigned_rebase" <<< "$out"; then
        fail_self_test "the unsigned-rebase instruction is missing: $out"
    fi

    printf 'M    containers/policy.json\n' > "$fixture/cmd/config-diff"
    if out=$(FIXTURE=$fixture TAG=stable cmd_plan 2>&1); then
        fail_self_test "a local policy.json did not abort the plan"
    fi

    if ! grep -qF "$local_copy_abort" <<< "$out"; then
        fail_self_test "local-copy abort message wrong: $(tail -n1 <<< "$out")"
    fi
}

# Already migrated: every step skipped, residue reported (an ntfsplus file, a
# karg, a modules-load file naming msi-ec).
self_test_plan_on_migrated_host() {
    local good=$1
    local fixture=$2
    local residue_step='6b. remove residue: /etc/modprobe.d/ntfsplus.conf'
    local out

    residue_step="$residue_step /etc/modules-load.d/msi-ec.conf module_blacklist=ntfsplus"
    mkdir -p "$fixture"
    cp -a "$good/." "$fixture/"
    printf 'blacklist ntfsplus\n' > "$fixture/etc/modprobe.d/ntfsplus.conf"
    printf 'msi-ec\n' > "$fixture/etc/modules-load.d/msi-ec.conf"
    printf 'root=UUID=x rw module_blacklist=ntfsplus\n' > "$fixture/cmd/kargs"
    sed 's/ ntfs / ntfs3 /' "$good/etc/fstab" > "$fixture/etc/fstab"
    self_test_migrated_status "$fixture/cmd/rpm-ostree-status.json"

    if ! out=$(FIXTURE=$fixture TAG=stable cmd_plan); then
        fail_self_test "plan failed on the migrated fixture: $out"
    fi

    if ! grep -q '3. (nothing layered: skipped)' <<< "$out" \
        || ! grep -q '5. (origin already' <<< "$out" \
        || ! grep -qF "$residue_step" <<< "$out"; then
        echo "self-test: the migrated plan does not skip or does not report the residue:"
        echo "$out"
        exit 1
    fi
}

# Opted into NTFSPLUS on an MSI host: fstab rows on ntfs are the host's
# choice, so step 6 is skipped and neither file is residue. The opt-in
# carries the text setup-ntfsplus writes, which names ntfsplus.
self_test_plan_keeps_fstab_on_optin() {
    local good=$1
    local fixture=$2
    local out residue_line

    mkdir -p "$fixture"
    cp -a "$good/." "$fixture/"
    ntfsplus_optin_text > "$fixture/etc/modprobe.d/bazzite-mx-ntfsplus.conf"
    printf 'msi-ec\nacpi_ec\n' > "$fixture/etc/modules-load.d/bazzite-mx-msi.conf"
    self_test_migrated_status "$fixture/cmd/rpm-ostree-status.json"

    if ! out=$(FIXTURE=$fixture TAG=stable cmd_plan); then
        fail_self_test "plan failed on the opted-in fixture: $out"
    fi

    residue_line=$(grep '6b\.' <<< "$out" || true)
    if ! grep -q '6. (ntfsplus opt-in active: fstab kept' <<< "$out" \
        || ! grep -q 'ntfsplus opt-in *active' <<< "$out" \
        || grep -qE 'bazzite-mx-(ntfsplus|msi)\.conf' <<< "$residue_line"; then
        echo "self-test: the opted-in plan rewrites fstab or reports the opt-in or setup-msi" \
            "file as residue:"
        echo "$out"
        exit 1
    fi
}

# Known-bad 4: the EXIT trap runs after cmd_apply has returned, so the flag
# it reads lives at script scope, set to 0, and restore_timer survives there.
self_test_timer_restored_at_exit() {
    local out

    if [ "$(declare -p TIMER_WAS_ACTIVE 2> /dev/null)" != 'declare -- TIMER_WAS_ACTIVE="0"' ]; then
        fail_self_test "TIMER_WAS_ACTIVE is not a script-level variable set to 0:" \
            "$(declare -p TIMER_WAS_ACTIVE 2>&1)"
    fi

    if ! out=$(
        systemctl() { echo "stub: systemctl $*"; }
        export -f systemctl restore_timer
        TIMER_WAS_ACTIVE=1 bash -euo pipefail -c 'trap restore_timer EXIT; :' 2>&1
    ); then
        fail_self_test "restore_timer died at EXIT: $out"
    fi

    if ! grep -q 'stub: systemctl start uupd.timer' <<< "$out" \
        || ! grep -q 'uupd.timer started again' <<< "$out"; then
        fail_self_test "restore_timer did not restart the timer at EXIT: $out"
    fi
}

self_test() {
    local dir

    dir=$(mktemp -d)
    # shellcheck disable=SC2064  # expand now: the local is gone at EXIT
    trap "rm -rf '$dir'" EXIT

    self_test_fstab "$dir/fstab"
    self_test_fstab_rewrite "$dir"

    self_test_unmigrated_fixture "$dir/fx" "$dir/fstab"
    self_test_plan_lists_the_steps "$dir/fx"
    self_test_plan_refuses_pending "$dir/fx" "$dir/fx2"
    self_test_plan_refuses_missing_scope "$dir/fx" "$dir/fx3"
    self_test_plan_on_migrated_host "$dir/fx" "$dir/fx4"
    self_test_plan_keeps_fstab_on_optin "$dir/fx" "$dir/fx5"
    self_test_timer_restored_at_exit

    echo "self-test ok: fstab rewrite exact, plan lists the steps, pending / missing scope /" \
        "local policy refused, residue reported, opt-in keeps fstab, timer flag at script" \
        "scope and restored at EXIT"
}

# --- main ---------------------------------------------------------------------

main() {
    local command=${1:-}

    TAG=${2:-${TAG:-stable}}

    case "$command" in
        plan)
            cmd_plan
            ;;
        apply)
            cmd_apply
            ;;
        fstab-rewrite)
            if [ $# -ne 3 ]; then
                exit_with_error "usage: bazzite-mx-migrate fstab-rewrite IN OUT"
            fi
            rewrite_fstab_ntfs_to_ntfs3 "$2" "$3"
            ;;
        --self-test)
            self_test
            ;;
        *)
            echo "usage: bazzite-mx-migrate plan|apply [TAG] | fstab-rewrite IN OUT |" \
                "--self-test" >&2
            exit 1
            ;;
    esac
}

main "$@"
