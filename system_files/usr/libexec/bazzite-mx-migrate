#!/usr/bin/env bash
# Bring a host that boots a bazzite-mx image to the state the image expects:
# the signed origin, no rpm-ostree mutation, the image's initramfs and
# /etc/containers, errors= on the `ntfs` rows of fstab, no ntfsplus or MSI
# leftover. It lists the changes, asks once, makes them; the reboot is the
# user's.
#
# Usage: bazzite-mx-migrate [TAG]       TAG defaults to stable; a dated tag pins
#                                       the host to that release
#        bazzite-mx-migrate --self-test
#   FIXTURE=<dir>: files read under <dir>, command outputs under <dir>/cmd/
#   (host.sh); the self-test uses it.
# Exit status: 0 done or nothing to do; 1 `ERROR: …` on stderr; 2 `ABORT: …`
#   on stderr, nothing changed.
# Writes: /var/tmp/bazzite-mx-migrate/<timestamp>/ with the files it replaces or
#   moves, the origin through rpm-ostree, /etc/containers, /etc/fstab.
set -euo pipefail

# shellcheck source=../lib/bazzite-mx/host.sh
source /usr/lib/bazzite-mx/host.sh

SIGNED="ostree-image-signed:docker://$VENDOR_SCOPE"
UNSIGNED="ostree-unverified-registry:$VENDOR_SCOPE"
BACKUP_ROOT=/var/tmp/bazzite-mx-migrate
TAG=stable
BACKUP=

# --- stopping -----------------------------------------------------------------

abort() {
    printf '%s\n' "ABORT: $1" "${@:2}" >&2
    exit 2
}

fail() {
    echo "ERROR: $1" >&2

    if [ -n "$BACKUP" ]; then
        echo "Backups: $BACKUP" >&2
    fi

    echo "Fix it and run ujust migrate again." >&2
    exit 1
}

# --- what the host has --------------------------------------------------------

src_config_diff() {
    if [ -n "$FIXTURE" ]; then
        cat "$FIXTURE/cmd/config-diff"
    else
        ostree admin config-diff
    fi
}

# The `ntfs` rows without an errors= option.
ntfs_rows() {
    local fstab=$1

    fstab_entries "$fstab" | awk '$3 == "ntfs" && $4 !~ /(^|,)errors=/'
}

# OVERRIDES are what only `override reset` drops; a repository replacement is
# `[<repo>, [<package>…]]`. A modified (`M`) policy.json or registries.d file
# shadows the image's, which the three-way merge of /etc never replaces.
detect() {
    local status booted config_diff kargs
    local overrides='."requested-base-removals", ."requested-base-local-replacements",
        ."requested-base-remote-replacements"'
    local shadowing='^M[[:space:]]+containers/(policy\.json|registries\.d/matrixdj96\.yaml)$'

    if ! status=$(src_rpm_ostree_status 2>&1); then
        fail "cannot read rpm-ostree status: $(reason_on_one_line "$status")."
    fi

    booted=$(booted_deployment "$status")

    if [ -z "$booted" ]; then
        fail "rpm-ostree status lists no booted deployment."
    fi

    PENDING=$(jq -r 'if .deployments[0].booted then ""
        else (.deployments[0].version // .deployments[0].checksum) end' <<< "$status")
    REF=$(jq -r '."container-image-reference" // ""' <<< "$booted")
    OVERRIDES=$(jq -r '[(."requested-base-removals" // [])[],
        (."requested-base-local-replacements" // [])[],
        (."requested-base-remote-replacements" // [])[][1][]] | unique | join(" ")' <<< "$booted")
    LAYERED=$(layered_requests "$(jq "del($overrides)" <<< "$booted")")
    REGEN=$(jq -r '."regenerate-initramfs" // false' <<< "$booted")
    IMAGE=$(image_name)

    if [ -z "$IMAGE" ]; then
        fail "$(host_file $IMAGE_INFO) is unreadable: not a bazzite-mx image."
    fi

    TARGET="$SIGNED/$IMAGE:$TAG"

    if ! config_diff=$(src_config_diff 2>&1); then
        fail "cannot read ostree admin config-diff: $(reason_on_one_line "$config_diff")."
    fi

    CONFIG_HITS=$(grep -E "$shadowing" <<< "$config_diff" || true)
    NTFS_ROWS=$(ntfs_rows "$(host_file /etc/fstab)")
    RESIDUE_FILES=$({
        ntfsplus_files
        msi_files
    } | sort -u || true)

    if ! kargs=$(src_kargs 2>&1); then
        fail "cannot read the kernel arguments: $(reason_on_one_line "$kargs")."
    fi

    RESIDUE_KARGS=$(ntfsplus_kargs "$kargs")
}

# The policy /etc gets once the local copy is put back: the image's own.
image_has_signing_policy() {
    jq -e --arg s "$VENDOR_SCOPE" '.transports.docker[$s][0].type == "sigstoreSigned"' \
        "$(host_file /usr/etc/containers/policy.json)" > /dev/null 2>&1
}

# One line per change, in the order they are made.
list_changes() {
    local rebase="switch to the signed image $VENDOR_SCOPE/$IMAGE:$TAG"

    if [ "$TAG" != stable ]; then
        rebase+=" (a dated tag: no update until 'ujust migrate stable')"
    fi

    if [ -n "$CONFIG_HITS" ]; then
        echo "put back the image's /etc/containers/policy.json and registries.d"
    fi

    if [ -n "$LAYERED" ]; then
        echo "remove the layered packages: $LAYERED"
    fi

    if [ -n "$OVERRIDES" ]; then
        echo "reset the base-package overrides: $OVERRIDES"
    fi

    if [ "$REGEN" = true ]; then
        echo "use the image's initramfs instead of a locally built one"
    fi

    if [ -n "$RESIDUE_KARGS" ]; then
        echo "delete the ntfsplus kernel arguments: ${RESIDUE_KARGS//$'\n'/ }"
    fi

    if [ "$REF" != "$TARGET" ]; then
        echo "$rebase"
    fi

    if [ -n "$NTFS_ROWS" ]; then
        echo "add errors=remount-ro to the ntfs rows of /etc/fstab:" \
            "$(awk '{ print $2 }' <<< "$NTFS_ROWS" | unescaped_on_one_line)"
    fi

    if [ -n "$RESIDUE_FILES" ]; then
        echo "move these leftover files into the backup: ${RESIDUE_FILES//$'\n'/ }"
    fi
}

# rpm-ostree refuses to queue on a running update, and on a pending one the
# list would not describe what boots next. The signed pull is checked against
# the running image's policy, so an image without it is left once unsigned.
check_gates() {
    if [ "$(systemctl is-active uupd.service || true)" = activating ]; then
        abort "an update is running (uupd.service activating)." \
            "Wait until it ends, then run ujust migrate again."
    fi

    if [ -n "$PENDING" ]; then
        abort "a deployment waits for the next boot ($PENDING)." \
            "Reboot, or discard it with sudo rpm-ostree cleanup -p, then run ujust migrate again."
    fi

    if ! image_has_signing_policy; then
        abort "this image has no signing policy for $VENDOR_SCOPE (it predates it)." \
            "Reach the image once unsigned, reboot, then run ujust migrate again:" \
            "  sudo rpm-ostree rebase $UNSIGNED/$IMAGE:$TAG" \
            "  systemctl reboot"
    fi
}

# --- the changes --------------------------------------------------------------

# A fixed root under sticky /var/tmp: another account could plant it. install
# -d takes it back, and mkdir without -p refuses a planted run directory.
open_backup() {
    local dir

    if [ -n "$BACKUP" ]; then
        return 0
    fi

    dir=$BACKUP_ROOT/$(date -u +%Y%m%dT%H%M%SZ)

    if ! install -d -m 0700 -o root -g root "$BACKUP_ROOT" 2> /dev/null \
        || ! mkdir "$dir" 2> /dev/null; then
        fail "cannot create $dir."
    fi

    BACKUP=$dir
}

restore_containers_config() {
    open_backup

    if ! cp -a /etc/containers/policy.json /etc/containers/registries.d "$BACKUP/"; then
        fail "cannot back up /etc/containers."
    fi

    if ! cp -a /usr/etc/containers/policy.json /etc/containers/policy.json \
        || ! cp -a /usr/etc/containers/registries.d/. /etc/containers/registries.d/; then
        fail "cannot put back /etc/containers from /usr/etc."
    fi
}

run_rpm_ostree() {
    if ! rpm-ostree "$@"; then
        fail "rpm-ostree $* failed."
    fi
}

# Refuses a table that adds a findmnt --verify error to the current one, or one
# findmnt gives no verdict on; an unplugged `nofail` volume is an error in both.
rewrite_fstab() {
    local rewritten added

    rewritten=$(mktemp)
    add_ntfs_errors_option /etc/fstab "$rewritten"

    if ! fstab_verify_answers /etc/fstab || ! fstab_verify_answers "$rewritten"; then
        rm -f "$rewritten"
        fail "findmnt --verify gave no verdict on /etc/fstab; not written."
    fi

    added=$(new_verify_errors /etc/fstab "$rewritten")

    if [ -n "$added" ]; then
        echo "$added" >&2
        rm -f "$rewritten"
        fail "the rewritten fstab adds findmnt --verify errors; /etc/fstab not written."
    fi

    open_backup

    # Written beside and renamed: a write cut short leaves /etc/fstab whole.
    if ! cp -a /etc/fstab "$BACKUP/fstab" \
        || ! install -m 0644 -o root -g root "$rewritten" /etc/fstab.new \
        || ! mv -f /etc/fstab.new /etc/fstab; then
        rm -f "$rewritten" /etc/fstab.new
        fail "cannot write /etc/fstab."
    fi

    rm -f "$rewritten"

    if ! systemctl daemon-reload; then
        fail "systemctl daemon-reload failed after writing /etc/fstab."
    fi
}

move_residue_files() {
    local path

    open_backup

    while IFS= read -r path; do
        if ! mkdir -p "$BACKUP$(dirname "$path")" || ! mv "$path" "$BACKUP$path"; then
            fail "cannot move $path into $BACKUP."
        fi
    done <<< "$RESIDUE_FILES"
}

make_changes() {
    local karg

    if [ -n "$CONFIG_HITS" ]; then
        restore_containers_config
    fi

    if [ -n "$LAYERED" ]; then
        run_rpm_ostree uninstall -q --all
    fi

    if [ -n "$OVERRIDES" ]; then
        run_rpm_ostree override reset -q --all
    fi

    if [ "$REGEN" = true ]; then
        run_rpm_ostree initramfs --disable
    fi

    while IFS= read -r karg; do
        if [ -n "$karg" ]; then
            run_rpm_ostree kargs -q --delete="$karg"
        fi
    done <<< "$RESIDUE_KARGS"

    if [ "$REF" != "$TARGET" ]; then
        run_rpm_ostree rebase "$TARGET"
    fi

    if [ -n "$NTFS_ROWS" ]; then
        rewrite_fstab
    fi

    if [ -n "$RESIDUE_FILES" ]; then
        move_residue_files
    fi
}

migrate() {
    local changes

    detect
    changes=$(list_changes)

    if [ -z "$changes" ]; then
        echo "Nothing to do: this host already runs the signed $VENDOR_SCOPE/$IMAGE:$TAG."
        return 0
    fi

    check_gates
    echo "ujust migrate would make these changes:"
    sed 's/^/  - /' <<< "$changes"

    if [ ! -t 0 ] || ! ugum confirm "Make them?"; then
        abort "not confirmed; nothing changed."
    fi

    make_changes
    echo "Done.${BACKUP:+ Backups: $BACKUP (deleted after 30 days).}"
    echo "Next: systemctl reboot, then ujust verify-host."
}

# --- self-test ----------------------------------------------------------------

fail_self_test() {
    echo "self-test: $*"
    exit 1
}

# Every `ntfs` row without errors= gains errors=remount-ro, the type possibly
# ending the row; comments, other types, rows with their own errors= and a
# label holding a `#` pass through.
self_test_fstab_rewrite() {
    local dir=$1

    printf '%s\n' '#LABEL=Old /mnt/old ntfs defaults 0 0' \
        'UUID=1111 /  btrfs subvol=root 0 0' \
        'UUID=2222 /mnt/win ntfs defaults,nofail,uid=1000 0 0' \
        'UUID=4444 /mnt/fuse ntfs-3g defaults,nofail 0 0' \
        'UUID=5555 /mnt/bare ntfs' \
        '   UUID=6666 /mnt/indented ntfs defaults,nofail 0 0' \
        'UUID=8888 /mnt/hand ntfs nofail,errors=continue 0 0' \
        'LABEL=Disco#2 /mnt/Disco2 ntfs defaults 0 0' > "$dir/in"
    printf '%s\n' '#LABEL=Old /mnt/old ntfs defaults 0 0' \
        'UUID=1111 /  btrfs subvol=root 0 0' \
        'UUID=2222 /mnt/win ntfs defaults,nofail,uid=1000,errors=remount-ro 0 0' \
        'UUID=4444 /mnt/fuse ntfs-3g defaults,nofail 0 0' \
        'UUID=5555 /mnt/bare ntfs errors=remount-ro' \
        '   UUID=6666 /mnt/indented ntfs defaults,nofail,errors=remount-ro 0 0' \
        'UUID=8888 /mnt/hand ntfs nofail,errors=continue 0 0' \
        'LABEL=Disco#2 /mnt/Disco2 ntfs defaults,errors=remount-ro 0 0' > "$dir/expected"
    add_ntfs_errors_option "$dir/in" "$dir/out"

    if ! diff "$dir/expected" "$dir/out" > /dev/null; then
        fail_self_test "the errors= rewrite gave another table:" \
            "$(diff "$dir/expected" "$dir/out" | tr '\n' ' ')"
    fi
}

# An unplugged nofail volume is a findmnt --verify error before and after the
# rewrite, so it adds nothing; a row on a missing mount point adds one; a
# 40-row table keeps every error on its mount point; a findmnt that dies after
# a diagnostic is no verdict.
self_test_fstab_verify() {
    local dir=$1
    local row

    printf 'UUID=DEAD /mnt/unplugged ntfs defaults,nofail 0 0\n' > "$dir/stale"
    add_ntfs_errors_option "$dir/stale" "$dir/stale-rewritten"

    if [ -n "$(new_verify_errors "$dir/stale" "$dir/stale-rewritten")" ]; then
        fail_self_test "the rewrite of a stale nofail row counts as a new error"
    fi

    printf 'UUID=BEEF /mnt/never/existed ntfs3 defaults,nofail 0 0\n' >> "$dir/stale-rewritten"

    if [ -z "$(new_verify_errors "$dir/stale" "$dir/stale-rewritten")" ]; then
        fail_self_test "a row adding an error was not reported as new"
    fi

    for row in $(seq 1 40); do
        printf 'UUID=%08d /mnt/big-%02d ntfs defaults,nofail 0 0\n' "$row" "$row"
    done > "$dir/big"

    if [ "$(fstab_verify_errors "$dir/big" | grep -vc '^/mnt/big-')" -ne 0 ]; then
        fail_self_test "an error line of a 40-row table lost its mount point"
    fi

    mkdir -p "$dir/bin"
    printf '#!/usr/bin/env bash\necho "findmnt: parse error at line 2" >&2\nexit 139\n' \
        > "$dir/bin/findmnt"
    chmod +x "$dir/bin/findmnt"

    if PATH=$dir/bin:$PATH fstab_verify_answers "$dir/stale"; then
        fail_self_test "a findmnt that dies after a diagnostic passed as a verdict"
    fi
}

# A host on this image unsigned and pinned, with a layered package, a base
# removal, a repository replacement, a local initramfs, a local policy.json,
# two ntfs rows, an ntfsplus file and karg.
self_test_fixture() {
    local fixture=$1

    mkdir -p "$fixture/cmd" "$fixture/etc/modprobe.d" "$fixture/usr/etc/containers" \
        "$fixture/usr/share/ublue-os"
    printf '{"image-name":"bazzite-mx"}\n' > "$fixture/usr/share/ublue-os/image-info.json"
    printf '%s\n' '{"transports": {"docker": {"ghcr.io/matrixdj96": [' \
        '{"type": "sigstoreSigned", "keyPath": "/etc/pki/containers/matrixdj96.pub"}]}}}' \
        > "$fixture/usr/etc/containers/policy.json"
    printf '%s\n' 'UUID=1111 /  btrfs subvol=root 0 0' \
        'UUID=2222 /mnt/win ntfs defaults,nofail 0 0' \
        'UUID=3333 /mnt/My\040Games ntfs nofail 0 0' > "$fixture/etc/fstab"
    printf 'options ntfsplus x=1\n' > "$fixture/etc/modprobe.d/ntfsplus.conf"
    printf 'M    containers/policy.json\nM    hosts\n' > "$fixture/cmd/config-diff"
    printf 'root=UUID=x rw module_blacklist=ntfsplus\n' > "$fixture/cmd/kargs"
    cat > "$fixture/cmd/rpm-ostree-status.json" << 'STATUS'
{"deployments": [
  {"booted": true,
   "container-image-reference":
     "ostree-unverified-registry:ghcr.io/matrixdj96/bazzite-mx:44.20260903",
   "packages": [], "requested-packages": ["1password"], "requested-base-removals": ["firefox"],
   "requested-base-remote-replacements": [["repo=copr:x", ["mesa-dri-drivers"]]],
   "regenerate-initramfs": true, "version": "44.20260903"}]}
STATUS
}

# The fixture lists every change in order; signed, clean and with no pending
# deployment it has nothing to do even while an update runs.
self_test_detection() {
    local dir=$1
    local fixture=$dir/host
    local signed=ostree-image-signed:docker://ghcr.io/matrixdj96/bazzite-mx:stable
    local nothing='Nothing to do: this host already runs the signed'
    local expected out

    self_test_fixture "$fixture"
    expected=$(printf '%s\n' \
        "put back the image's /etc/containers/policy.json and registries.d" \
        'remove the layered packages: 1password' \
        'reset the base-package overrides: firefox mesa-dri-drivers' \
        "use the image's initramfs instead of a locally built one" \
        'delete the ntfsplus kernel arguments: module_blacklist=ntfsplus' \
        'switch to the signed image ghcr.io/matrixdj96/bazzite-mx:stable' \
        'add errors=remount-ro to the ntfs rows of /etc/fstab: /mnt/win /mnt/My Games' \
        'move these leftover files into the backup: /etc/modprobe.d/ntfsplus.conf')
    out=$(FIXTURE=$fixture detect && FIXTURE=$fixture list_changes)

    if [ "$out" != "$expected" ]; then
        fail_self_test "the changes listed differ:" "$(diff <(echo "$expected") <(echo "$out"))"
    fi

    jq -n --arg ref "$signed" \
        '{deployments: [{booted: true, "container-image-reference": $ref}]}' \
        > "$fixture/cmd/rpm-ostree-status.json"
    printf 'M    hosts\n' > "$fixture/cmd/config-diff"
    printf 'root=UUID=x rw\n' > "$fixture/cmd/kargs"
    printf 'UUID=2222 /mnt/win ntfs defaults,nofail,errors=remount-ro 0 0\n' > "$fixture/etc/fstab"
    rm "$fixture/etc/modprobe.d/ntfsplus.conf"

    if ! out=$(
        systemctl() { echo activating; }
        FIXTURE=$fixture migrate 2>&1
    ) || [ "$out" != "$nothing ghcr.io/matrixdj96/bazzite-mx:stable." ]; then
        fail_self_test "a migrated host has something to do: $out"
    fi
}

# What make_changes runs on the host <fixture>, the changes stubbed.
self_test_make_changes() {
    restore_containers_config() { echo "${FUNCNAME[0]}"; }
    run_rpm_ostree() { echo "$*"; }
    rewrite_fstab() { echo "${FUNCNAME[0]}"; }
    move_residue_files() { echo "${FUNCNAME[0]}"; }
    FIXTURE=$1 detect
    make_changes
}

# The fixture's changes run in the listed order, the rebase to the signed tag;
# a signed, clean host with an ntfs row left runs the fstab rewrite alone.
self_test_changes() {
    local dir=$1
    local fixture=$dir/host
    local signed=ostree-image-signed:docker://ghcr.io/matrixdj96/bazzite-mx:stable
    local expected out

    self_test_fixture "$fixture"
    expected=$(printf '%s\n' restore_containers_config 'uninstall -q --all' \
        'override reset -q --all' 'initramfs --disable' \
        'kargs -q --delete=module_blacklist=ntfsplus' "rebase $signed" \
        rewrite_fstab move_residue_files)
    out=$(self_test_make_changes "$fixture")

    if [ "$out" != "$expected" ]; then
        fail_self_test "the changes made differ:" "$(diff <(echo "$expected") <(echo "$out"))"
    fi

    jq -n --arg ref "$signed" \
        '{deployments: [{booted: true, "container-image-reference": $ref}]}' \
        > "$fixture/cmd/rpm-ostree-status.json"
    printf 'M    hosts\n' > "$fixture/cmd/config-diff"
    printf 'root=UUID=x rw\n' > "$fixture/cmd/kargs"
    rm "$fixture/etc/modprobe.d/ntfsplus.conf"
    out=$(self_test_make_changes "$fixture")

    if [ "$out" != rewrite_fstab ]; then
        fail_self_test "a host with only the fstab change left ran more: $out"
    fi
}

# A running update and a pending deployment each stop the run before any
# change, and so do a run without a terminal and an image without the signing
# policy.
self_test_gates() {
    local dir=$1
    local fixture=$dir/host
    local out

    self_test_fixture "$fixture"

    if out=$(
        systemctl() { echo activating; }
        FIXTURE=$fixture migrate 2>&1
    ) || ! grep -q '^ABORT: an update is running' <<< "$out"; then
        fail_self_test "a running update did not stop the run: $out"
    fi

    jq '.deployments = [{"booted": false, "version": "44.20261105"}] + .deployments' \
        "$fixture/cmd/rpm-ostree-status.json" > "$dir/status"
    mv "$dir/status" "$fixture/cmd/rpm-ostree-status.json"

    if out=$(
        systemctl() { echo inactive; }
        FIXTURE=$fixture migrate 2>&1
    ) || ! grep -q '^ABORT: a deployment waits for the next boot (44.20261105)' <<< "$out"; then
        fail_self_test "a pending deployment did not stop the run: $out"
    fi

    self_test_fixture "$fixture"

    if out=$(
        systemctl() { echo inactive; }
        make_changes() { echo "changes made"; }
        FIXTURE=$fixture migrate < /dev/null 2>&1
    ) || ! grep -q '^ABORT: not confirmed' <<< "$out"; then
        fail_self_test "a run without a terminal was not refused: $out"
    fi

    self_test_fixture "$fixture"
    printf '{}\n' > "$fixture/usr/etc/containers/policy.json"

    if out=$(
        systemctl() { echo inactive; }
        FIXTURE=$fixture migrate 2>&1
    ) || ! grep -q '^ABORT: this image has no signing policy' <<< "$out"; then
        fail_self_test "an image without the signing policy did not stop the run: $out"
    fi
}

self_test() {
    local dir

    dir=$(mktemp -d)
    # shellcheck disable=SC2064  # expand now: the local is gone at EXIT
    trap "rm -rf '$dir'" EXIT

    self_test_fstab_rewrite "$dir"
    self_test_fstab_verify "$dir"
    self_test_detection "$dir"
    self_test_changes "$dir"
    self_test_gates "$dir"

    echo "self-test ok: fstab rewrite and its verification, every change listed and made in" \
        "order, nothing to do on a migrated host, a running or pending update, no terminal and an" \
        "image without the signing policy refused"
}

# --- main ---------------------------------------------------------------------

main() {
    case "${1:-}" in
        --self-test)
            self_test
            ;;
        -*)
            exit_with_error "usage: bazzite-mx-migrate [TAG] | --self-test"
            ;;
        *)
            TAG=${1:-stable}
            require_root bazzite-mx-migrate migrate
            migrate
            ;;
    esac
}

main "$@"
