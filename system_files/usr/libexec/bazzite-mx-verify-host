#!/usr/bin/env bash
# Is this host where the image expects it? The checks behind `ujust
# verify-host`: the deployment bootc-compatible, the origin signed and on
# `stable`, nothing layered, the image's signing policy in force, the MSI
# modules on an MSI host, the flavour matching the GPU, ntfs3 in fstab and
# mounted, no residue of an earlier setup, the
# Firefox Flatpak reported (the system scope and the invoking user's), the
# .repo files the image adds to the base as it ships them.
#
# Usage: bazzite-mx-verify-host        (root: bootc status needs it; the recipe
#                                       runs it through sudo)
#   FIXTURE=<dir>: files read under <dir>, command outputs under <dir>/cmd/
#   (the smoke test; host.sh routes the shared ones); no root needed.
# Output: one `OK:`, `FAIL:`, `SKIP:` or `INFO:` line per check, then
#   `verify-host: every check passed` or `verify-host: FAIL lines above`.
#   docs/migration.md maps the FAIL lines to their fix: a line it cites stays
#   as it is.
# Exit status: 0 every check passed; 1 at least one FAIL, or a findfs that
#   could not answer (its `ERROR: …` on stderr, `set -e` ending the run); 2 the
#   host could not be read (not root, not a bazzite-mx image, no booted
#   deployment), the reason on stderr as `ERROR: …`.
set -euo pipefail

# shellcheck source=../lib/bazzite-mx/host.sh
source /usr/lib/bazzite-mx/host.sh

REGISTRIES=/etc/containers/registries.d/matrixdj96.yaml
NVIDIA_VENDOR_ID=10de
REPOS_BASE_SNAPSHOT=/usr/lib/bazzite-mx/build-state/repos.base.sha256

# Set by read_host and read by the checks.
IMAGE_NAME=
BOOTED=
BOOTC=

# Set by the first FAIL line, read at the end.
ANY_CHECK_FAILED=0

# --- the report lines ---------------------------------------------------------

report_ok() {
    echo "OK: $*"
}

report_fail() {
    echo "FAIL: $*"
    ANY_CHECK_FAILED=1
}

report_skip() {
    echo "SKIP: $*"
}

report_info() {
    echo "INFO: $*"
}

# --- command sources of this helper alone (the shared ones: host.sh) ----------

src_bootc_status() {
    if [ -n "$FIXTURE" ]; then
        cat "$FIXTURE/cmd/bootc-status.json"
    else
        bootc status --format=json
    fi
}

src_lspci_nvidia() {
    if [ -n "$FIXTURE" ]; then
        cat "$FIXTURE/cmd/lspci-nvidia"
    else
        lspci -d "$NVIDIA_VENDOR_ID:" -n
    fi
}

# The recipe runs the helper through sudo, and root's `flatpak list` sees
# the system installation and root's own user one, never the invoking
# user's: that scope is listed as SUDO_USER (docs/gotchas.md § Root's
# `flatpak list` misses the invoking user's installation). A flatpak that
# cannot list is not a host without Flatpaks: each status is kept and
# check_flatpaks names the reason.
src_flatpaks() {
    if [ -n "$FIXTURE" ]; then
        cat "$FIXTURE/cmd/flatpaks"
        return 0
    fi

    if ! flatpak list --app --system --columns=application; then
        return 1
    fi

    if [ -n "${SUDO_USER:-}" ]; then
        if ! runuser -u "$SUDO_USER" -- flatpak list --app --user --columns=application; then
            return 1
        fi
    fi
}

module_loaded() {
    local module=$1
    local loaded

    loaded=$(awk '{ print $1 }' "$(host_file /proc/modules)" 2> /dev/null || true)

    grep -qx "$module" <<< "$loaded"
}

# --- reading the host ---------------------------------------------------------

# Exit 2 when the host cannot be read: the checks would all fail for one
# reason, and that reason is the message.
read_host() {
    local status

    if [ -z "$FIXTURE" ] && [ "$(id -u)" -ne 0 ]; then
        echo "ERROR: run as root (ujust verify-host does it through sudo):" \
            "bootc status needs it" >&2
        exit 2
    fi

    IMAGE_NAME=$(image_name)

    if [ -z "$IMAGE_NAME" ]; then
        echo "ERROR: $(host_file $IMAGE_INFO) missing: not a bazzite-mx image?" >&2
        exit 2
    fi

    if ! status=$(src_rpm_ostree_status 2>&1); then
        echo "ERROR: cannot read rpm-ostree status: $(reason_on_one_line "$status")" >&2
        exit 2
    fi

    if ! jq -e . <<< "$status" > /dev/null 2>&1; then
        echo "ERROR: rpm-ostree status is not JSON: the host cannot be read" >&2
        exit 2
    fi

    if ! BOOTED=$(booted_deployment "$status" 2>&1); then
        echo "ERROR: cannot read the deployments of rpm-ostree status:" \
            "$(reason_on_one_line "$BOOTED")" >&2
        exit 2
    fi

    if [ -z "$BOOTED" ]; then
        echo "ERROR: rpm-ostree status lists no booted deployment" >&2
        exit 2
    fi

    # bootc status waits for the sysroot lock an update holds, silently
    # when stderr is not a terminal, as in the capture below.
    if [ -z "$FIXTURE" ] && [ "$(systemctl is-active uupd.service || true)" = activating ]; then
        echo "verify-host: uupd.service is activating (an update running, or its restart" \
            "queued after a failure): bootc status may wait for it" >&2
    fi

    if ! BOOTC=$(src_bootc_status 2>&1); then
        echo "ERROR: cannot read bootc status: $(reason_on_one_line "$BOOTC")" >&2
        exit 2
    fi

    if ! jq -e . <<< "$BOOTC" > /dev/null 2>&1; then
        echo "ERROR: bootc status is not JSON: the host cannot be read" >&2
        exit 2
    fi
}

# --- 1. bootc -----------------------------------------------------------------

# An rpm-ostree group in the origin makes the deployment incompatible
# (bootc's utils.rs).
check_bootc_compatibility() {
    local incompatible image

    incompatible=$(jq -r '.status.booted.incompatible' <<< "$BOOTC")
    image=$(jq -r '.status.booted.image.image.image // "?"' <<< "$BOOTC")

    if [ "$incompatible" = false ]; then
        report_ok "bootc status: the booted deployment is bootc-compatible (image $image)"
    else
        report_fail "bootc status reports the booted deployment incompatible" \
            "(rpm-ostree groups in the origin: ujust migrate)"
    fi
}

# --- 2. the origin ------------------------------------------------------------

# Signed transport, our repository, tag stable (an origin left on a dated
# tag never sees an update).
check_origin() {
    local ref signed_prefix rest origin_tag

    ref=$(jq -r '."container-image-reference" // ""' <<< "$BOOTED")
    signed_prefix="ostree-image-signed:docker://$VENDOR_SCOPE/"

    if [[ $ref != "$signed_prefix"* ]]; then
        report_fail "origin is not $signed_prefix<image>:<tag> (got '$ref'): ujust migrate"
        return 0
    fi

    report_ok "origin uses the signed transport ($ref)"

    rest=${ref#"$signed_prefix"}
    origin_tag=${rest#*:}

    if [ "$origin_tag" = "$rest" ]; then
        origin_tag=latest
    fi

    if [ "$origin_tag" = stable ]; then
        report_ok "origin tag is stable (updates follow the moving alias)"
    else
        report_fail "origin tag is $origin_tag, not stable (a dated tag never updates):" \
            "ujust migrate apply stable"
    fi
}

# --- 3. nothing layered -------------------------------------------------------

# Every request list of the origin (host.sh), and no local initramfs.
check_no_mutations() {
    local layered regenerate initramfs_args

    layered=$(layered_requests "$BOOTED")

    if [ -z "$layered" ]; then
        report_ok "no layered, local or removed packages and no modules requested"
    else
        report_fail "rpm-ostree mutations in the origin: $layered (ujust migrate removes" \
            "package requests; an override needs sudo rpm-ostree override reset --all)"
    fi

    regenerate=$(jq -r '."regenerate-initramfs" // false' <<< "$BOOTED")

    if [ "$regenerate" = false ]; then
        report_ok "initramfs is the image's (no local regeneration)"
    else
        initramfs_args=$(jq -r '(."initramfs-args" // []) | join(" ")' <<< "$BOOTED" || true)
        report_fail "initramfs is regenerated locally ($initramfs_args):" \
            "rpm-ostree initramfs --disable, ujust migrate does it"
    fi
}

# --- 4. the signing policy ----------------------------------------------------

check_policy_scope_and_key() {
    local policy=$1
    local keypath default_type default_json

    keypath=$(jq -r --arg s "$VENDOR_SCOPE" '.transports.docker[$s][0].keyPath // ""' "$policy")

    if [ -n "$keypath" ] && [ -s "$(host_file "$keypath")" ]; then
        report_ok "policy.json: $VENDOR_SCOPE is sigstoreSigned with key $keypath present"
    else
        report_fail "policy.json: $VENDOR_SCOPE scope names key '$keypath', which is missing" \
            "(restore it from /usr/etc; sudo ostree admin config-diff)"
    fi

    default_type=$(jq -r '.default[0].type // ""' "$policy")

    if [ "$default_type" = reject ]; then
        report_ok "policy.json: default is reject"
    else
        default_json=$(jq -c '.default' "$policy")
        report_fail "policy.json: default is $default_json, the image ships reject" \
            "(a local edit? sudo ostree admin config-diff)"
    fi
}

# The policy the image ships is the one in force, and registries.d asks for
# the sigstore attachments.
check_signing_policy() {
    local policy registries

    policy=$(host_file /etc/containers/policy.json)

    if [ "$(policy_scope_type)" = sigstoreSigned ]; then
        check_policy_scope_and_key "$policy"
    else
        report_fail "policy.json has no sigstoreSigned scope for $VENDOR_SCOPE: the booted image" \
            "predates the policy, or /etc/containers/policy.json is a local copy" \
            "(sudo ostree admin config-diff)"
    fi

    registries=$(host_file $REGISTRIES)

    if [ -s "$registries" ] && grep -q 'use-sigstore-attachments: true' "$registries"; then
        report_ok "registries.d: sigstore attachments enabled for $VENDOR_SCOPE"
    else
        report_fail "$REGISTRIES missing or without use-sigstore-attachments" \
            "(restore it from /usr/etc; sudo ostree admin config-diff)"
    fi
}

# --- 5. MSI -------------------------------------------------------------------

# The modules on an MSI host that opted in, and no modules-load file of the
# host's own. setup-msi is a per-host opt-in: a host that ran
# `setup-msi disable` is a host that chose to go without the modules, and a
# FAIL there would advise undoing that choice at every run.
check_msi_modules() {
    local vendor module residue

    vendor=$(cat "$(host_file /sys/class/dmi/id/sys_vendor)" 2> /dev/null || true)
    vendor=${vendor:-unknown}

    if ! grep -qi 'micro-star' <<< "$vendor"; then
        report_skip "not an MSI host ($vendor): msi-ec and acpi_ec not expected"
    elif ! msi_optin; then
        report_skip "MSI host without the setup-msi opt-in ($MSI_MODULES_LOAD):" \
            "msi-ec and acpi_ec not expected"
    else
        for module in msi_ec acpi_ec; do
            if module_loaded "$module"; then
                report_ok "MSI host: $module loaded"
            else
                report_fail "MSI host: $module not loaded (ujust setup-msi enable)"
            fi
        done
    fi

    residue=$(msi_files)

    if [ -z "$residue" ]; then
        report_ok "no MSI residue under /etc/modules-load.d"
    else
        report_fail "MSI residue: $(tr '\n' ' ' <<< "$residue")(a modules-load file of the" \
            "host's own; ujust migrate offers the removal)"
    fi
}

# --- 6. the GPU and the flavour -----------------------------------------------

check_gpu_matches_flavour() {
    local nvidia

    if ! nvidia=$(src_lspci_nvidia 2>&1); then
        report_fail "cannot read the PCI bus: $(reason_on_one_line "$nvidia")"
        return 0
    fi

    if [ -z "$nvidia" ]; then
        if [[ $IMAGE_NAME == *nvidia* ]]; then
            report_fail "no NVIDIA GPU on the bus but the image is $IMAGE_NAME:" \
                "rebase to bazzite-mx"
        else
            report_ok "no NVIDIA GPU and the image is $IMAGE_NAME"
        fi

        return 0
    fi

    if [[ $IMAGE_NAME == *nvidia* ]]; then
        report_ok "NVIDIA GPU present ($(head -n1 <<< "$nvidia")) and the image is $IMAGE_NAME"
    else
        report_fail "NVIDIA GPU present but the image is $IMAGE_NAME:" \
            "rebase to bazzite-mx-nvidia-open (or bazzite-mx-nvidia)"
        return 0
    fi

    if module_loaded nvidia; then
        report_ok "nvidia module loaded"
    elif [[ $IMAGE_NAME == *nvidia-open ]]; then
        report_fail "nvidia module not loaded (nvidia-smi, journalctl -k -b;" \
            "a Maxwell, Pascal or Volta GPU needs bazzite-mx-nvidia)"
    else
        report_fail "nvidia module not loaded (nvidia-smi, journalctl -k -b)"
    fi
}

# --- 7. NTFS ------------------------------------------------------------------

# check_fstab_row <source> <target> <type> <options> <expected type>: the row
# on the expected driver, and the volume mounted with it. Not mounted
# is what the row asks for when it carries noauto, and a row with
# x-systemd.automount carries autofs at its target until the first access;
# a volume whose device is absent (an external disk unplugged) is a failure
# only when the row lacks nofail: with it the boot went on without the
# volume, as the row asks. Fields are read as fstab(5) writes them
# (unescape_fstab_field, host.sh).
check_fstab_row() {
    local source=$1
    local target
    local type=$3
    local options=,$4,
    local want=$5
    local mounted device=

    target=$(unescape_fstab_field "$2")

    if [ "$type" != "$want" ]; then
        report_fail "fstab: $target uses type $type, not $want (ujust migrate rewrites it)"

        return 0
    fi

    mounted=$(mount_fstype "$target")

    if [ -z "$mounted" ] && [[ $options != *,noauto,* ]]; then
        device=$(src_block_device "$source")
    fi

    if [ "$mounted" = "$want" ]; then
        report_ok "fstab: $target is $want and mounted with $want"
    elif [ "$mounted" = autofs ] && [[ $options == *,x-systemd.automount,* ]]; then
        report_ok "fstab: $target is $want, armed by systemd's automount"
    elif [ -n "$mounted" ]; then
        report_fail "fstab: $target is $want in fstab but mounted as $mounted" \
            "(umount and mount it again, or reboot)"
    elif [[ $options == *,noauto,* ]]; then
        report_info "fstab: $target ($want, noauto): not mounted, as the row asks"
    elif [ -n "$device" ]; then
        report_fail "fstab: $target is $want but not mounted" \
            "(dirty volume? journalctl -b | grep $want)"
    elif [[ $options == *,nofail,* ]]; then
        report_info "fstab: $target ($want, nofail): device absent, not mounted"
    else
        report_fail "fstab: $target is $want but its device $source is absent" \
            "(the row lacks nofail: the boot waits for it)"
    fi
}

check_ntfs_residue() {
    local residue kargs

    residue=$(ntfsplus_files)

    if [ -z "$residue" ]; then
        report_ok "no ntfsplus residue under /etc/modprobe.d or /etc/modules-load.d"
    else
        report_fail "ntfsplus residue: $(tr '\n' ' ' <<< "$residue")(ujust migrate offers" \
            "the removal)"
    fi

    if ! kargs=$(src_kargs 2>&1); then
        report_fail "cannot read the kernel arguments: $(reason_on_one_line "$kargs")"
        return 0
    fi

    residue=$(ntfsplus_kargs "$kargs")

    if [ -n "$residue" ]; then
        report_fail "kernel arguments mention ntfsplus: $(tr '\n' ' ' <<< "$residue")(ujust" \
            "migrate offers the removal)"
    else
        report_ok "no ntfsplus kernel argument"
    fi
}

# The ntfs3 driver in fstab and
# mounted as such; FUSE rows are the explicit route and are reported only.
check_ntfs() {
    local fstab fuse_rows rows source target type options

    fstab=$(host_file /etc/fstab)

    fuse_rows=$(fstab_entries "$fstab" | awk '$3 == "ntfs-3g" { print $2 }' || true)

    if [ -n "$fuse_rows" ]; then
        report_info "fstab rows on ntfs-3g (FUSE, the explicit route, left alone):" \
            "$(unescaped_on_one_line <<< "$fuse_rows")"
    fi

    rows=$(fstab_entries "$fstab" \
        | awk '$3 ~ /^ntfs/ { if ($3 != "ntfs-3g") print $1, $2, $3, $4 }' || true)

    if [ -z "$rows" ]; then
        report_skip "no NTFS entry in fstab"
    else
        while read -r source target type options; do
            check_fstab_row "$source" "$target" "$type" "$options" ntfs3
        done <<< "$rows"
    fi

    check_ntfs_residue
}

# --- 8. Flatpaks --------------------------------------------------------------

# Nothing is required by the image; Firefox is reported.
check_flatpaks() {
    local flatpaks

    if ! flatpaks=$(src_flatpaks 2>&1); then
        report_fail "cannot list the Flatpaks: $(reason_on_one_line "$flatpaks")"
        return 0
    fi

    if grep -qx org.mozilla.firefox <<< "$flatpaks"; then
        report_info "the Firefox Flatpak is still installed next to the RPM: copy the profile" \
            "before the first RPM start, then remove the Flatpak; the copy, for either tree:" \
            "[ -e ~/.mozilla ] || [ ! -d ~/.var/app/org.mozilla.firefox/.mozilla ]" \
            "|| cp -a ~/.var/app/org.mozilla.firefox/.mozilla ~/;" \
            "[ -e ~/.config/mozilla ] || [ ! -d ~/.var/app/org.mozilla.firefox/config/mozilla ]" \
            "|| cp -a ~/.var/app/org.mozilla.firefox/config/mozilla ~/.config/"
    else
        report_ok "no Firefox Flatpak (the RPM is the image's browser)"
    fi
}

# --- 9. the image's repositories ----------------------------------------------

# A .repo the build added over the base (00-prep.sh's snapshot names the
# base's) and the host edited is carried over the image's copy at every
# deployment by ostree's /etc merge, so it never follows the image again; one
# the host deleted stays deleted, its choice.
check_image_repos() {
    local base_names image_repo name edited=0

    base_names=$(awk '{ print $2 }' "$(host_file $REPOS_BASE_SNAPSHOT)")

    for image_repo in "$(host_file /usr/etc/yum.repos.d)"/*.repo; do
        name=$(basename "$image_repo")

        if grep -qxF "$name" <<< "$base_names" \
            || [ ! -f "$(host_file "/etc/yum.repos.d/$name")" ] \
            || cmp -s "$image_repo" "$(host_file "/etc/yum.repos.d/$name")"; then
            continue
        fi

        report_fail "/etc/yum.repos.d/$name differs from the image's copy (restore it from" \
            "/usr/etc: sudo cp -a /usr/etc/yum.repos.d/$name /etc/yum.repos.d/)"
        edited=1
    done

    if [ "$edited" -eq 0 ]; then
        report_ok "the image's .repo files under /etc/yum.repos.d are as it ships them"
    fi
}

# --- main ---------------------------------------------------------------------

main() {
    read_host

    check_bootc_compatibility
    check_origin
    check_no_mutations
    check_signing_policy
    check_msi_modules
    check_gpu_matches_flavour
    check_ntfs
    check_flatpaks
    check_image_repos

    if [ "$ANY_CHECK_FAILED" -ne 0 ]; then
        echo "verify-host: FAIL lines above"
        exit 1
    fi

    echo "verify-host: every check passed"
}

main "$@"
